<script>
  const addCartBtn = document.querySelector<HTMLButtonElement>(
    "[data-detail-add-cart]",
  );
  const addBundleBtn = document.querySelector<HTMLButtonElement>(
    "[data-detail-add-bundle]",
  );

  addCartBtn?.addEventListener("click", () => {
    const id = addCartBtn.dataset.templateId || "";
    const title = addCartBtn.dataset.templateTitle || "";
    const price = Number(addCartBtn.dataset.templatePrice || 0);
    const polarUrl = addCartBtn.dataset.polarUrl || "";

    window.dispatchEvent(
      new CustomEvent("cv:cart-add", {
        detail: { id, title, price, polarUrl },
      }),
    );
  });

  addBundleBtn?.addEventListener("click", () => {
    const price = Number(addBundleBtn.dataset.bundlePrice || 246);
    window.dispatchEvent(
      new CustomEvent("cv:cart-add", {
        detail: {
          id: "bundle-all-access",
          title: "All-Access Studio Bundle (All 8 Templates)",
          price,
        },
      }),
    );
  });
</script>
