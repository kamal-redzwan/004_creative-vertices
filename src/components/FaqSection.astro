---
import type { EmDashFaqItem } from "../data/emdash-cms";

interface Props {
  faqs: EmDashFaqItem[];
}

const { faqs } = Astro.props;
---

<section
  id="faq"
  aria-labelledby="faq-heading"
  class="border-b border-dashed border-[var(--cv-rail)] px-4 py-12 sm:px-6 lg:px-8 lg:py-16"
>
  <cv-accordion class="block">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
          TECHNICAL DOCUMENTATION // FAQ
        </p>
        <h2
          id="faq-heading"
          class="mt-2 text-2xl font-bold tracking-tight text-[var(--cv-text)] sm:text-3xl"
        >
          Architecture &amp; Licensing Questions
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--cv-text-muted)]">
          Specific answers regarding EmDash Content Layer synchronization,
          Tailwind CSS v4 stylesheets, native Web Component hydration, and
          agency client rights.
        </p>
      </div>

      <div class="lg:col-span-8">
        {faqs.map((item, idx) => (
          <details
            data-faq-item
            data-expanded={idx === 0 ? "true" : "false"}
            open={idx === 0}
            class="group border-b border-gray-800 pbpb-6 mb6 mb-6 last:mb-06 last:mb-0"
          >
            <summary class="flex min-h-11 list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
            <summary class="flex min-h-11 list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
              <div class="flex flex-col gap-1 text-left">
                <span class="font-mono text-[11px] font-bold tracking-wider text-[var(--cv-accent)]">
                  0{idx + 1} // {item.category}
                </span>
                <span class="text-base font-bold text-[var(--cv-text)]">
                  {item.question}
                </span>
              </div>
              <span
                aria-hidden="true"
                class="inline-flex shrink-0 items-center justify-center text-orangeorange-500500"
              >
                <svg
                  class="block h-5 w-5 group-open:hidden"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="square"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
                <svg
                  class="hidden h-5 w-5 group-open:block"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="square"
                >
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
                <svg
                  data-icon-plus
                  class={`h-5 w-5 ${idx === 0 ? "hidden" : "block"}`}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="square"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
                <svg
                  data-icon-cross
                  class={`h-5 w-5 ${idx === 0 ? "block" : "hidden"}`}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="square"
                >
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
              </span>
            </summary>
            <div
              data-faq-body
              class="mtmt-33 prpr-88 text-sm leading-relaxed text-[var(--cv-text-muted)]"
            >
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </cv-accordion>
</section>

<script>
  class CvAccordion extends HTMLElement {
    private animations = new WeakMap<HTMLDetailsElement, Animation>();

    connectedCallback() {
      const detailsList =
        this.querySelectorAll<HTMLDetailsElement>("[data-faq-item]");

      detailsList.forEach((details) => {
        const summary = details.querySelector<HTMLElement>("summary");
        if (!summary) return;

        this.syncIconState(details, details.hasAttribute("open"));

        summary.addEventListener("click", (event) => {
          event.preventDefault();

          const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          const isCurrentlyExpanded = details.dataset.expanded === "true";

          if (isCurrentlyExpanded) {
            this.closeItem(details, summary, prefersReducedMotion);
          } else {
            // Smoothly close any other open FAQ item before/while opening the newly clicked item.
            detailsList.forEach((otherDetails) => {
              if (
                otherDetails !== details &&
                (otherDetails.dataset.expanded === "true" ||
                  otherDetails.hasAttribute("open"))
              ) {
                const otherSummary =
                  otherDetails.querySelector<HTMLElement>("summary");
                if (otherSummary) {
                  this.closeItem(
                    otherDetails,
                    otherSummary,
                    prefersReducedMotion,
                  );
                }
              }
            });

            this.openItem(details, summary, prefersReducedMotion);
          }
        });
    }
    private syncIconStatedetails: HTMLDetailsElementisExpanded:boolean)
      detailsdataset.expandedStringisExpanded)const plusIcon = details.querySelector<SVGElement>("[data-icon-plus]");
      const crossIcon = details.querySelector<SVGElement>("[data-icon-cross]"      plusIcon?.classList.toggle("hidden", isExpanded);
      plusIcon?.classList.toggle("block", !isExpanded);
      crossIcon?.classList.toggle("block", isExpanded);
      crossIcon?.classList.toggle("hidden", !isExpanded);
    }

    private getClosedHeight(
      details: HTMLDetailsElement,
      summary: HTMLElement,
    ): number {
      const styles = window.getComputedStyle(details);
      const paddingY =
        parseFloat(styles.paddingTop) + parseFloat(styles.paddingBottom);
      const borderY =
        parseFloat(styles.borderTopWidth) +
        parseFloat(styles.borderBottomWidth);
      return summary.offsetHeight + paddingY + borderY;
    }

    private openItem(
      details: HTMLDetailsElement,
      summary: HTMLElement,
      prefersReducedMotion: boolean,
    ) {
      this.syncIconState(details, true);

      const runningAnim = this.animations.get(details);
      const startHeight = runningAnim
        ? details.offsetHeight
        : this.getClosedHeight(details, summary);
      if (runningAnim) {
        runningAnim.cancel();
        this.animations.delete(details);
      }

      details.setAttribute("open", "");

      if (prefersReducedMotion) {
        details.style.height = "";
        details.style.overflow = "";
        return;
      }

      const endHeight = details.offsetHeight;
      details.style.overflow = "hidden";

      const anim = details.animate(
        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
        { duration: 220, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
      );
      this.animations.set(details, anim);

      anim.onfinish = () => {
        details.style.height = "";
        details.style.overflow = "";
        this.animations.delete(details);
      };
    }

    private closeItem(
      details: HTMLDetailsElement,
      summary: HTMLElement,
      prefersReducedMotion: boolean,
    ) {
      this.syncIconState(details, false);

      const runningAnim = this.animations.get(details);
      const startHeight = details.offsetHeight;
      if (runningAnim) {
        runningAnim.cancel();
        this.animations.delete(details);
      }

      if (prefersReducedMotion) {
        details.removeAttribute("open");
        details.style.height = "";
        details.style.overflow = "";
        return;
      }

      const endHeight = this.getClosedHeight(details, summary);
      details.style.overflow = "hidden";

      const anim = details.animate(
        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
        { duration: 220, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
      );
      this.animations.set(details, anim);

      anim.onfinish = () => {
        details.removeAttribute("open");
        details.style.height = "";
        details.style.overflow = "";
        this.animations.delete(details);
      };
    }
  }

  if (!customElements.get("cv-accordion")) {
    customElements.define("cv-accordion", CvAccordion);
  }
</script>
