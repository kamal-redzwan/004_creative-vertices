---
import { getCollection, getLiveCollection } from "astro:content";
import "../../styles/global.css";
import NavBar from "../../components/NavBar.astro";
import CartDrawer from "../../components/CartDrawer.astro";
import type { ColorSwatch } from "../../data/emdash-cms";
import {
  emdashStorefrontData,
  bundleDiscountPrice,
} from "../../data/emdash-cms";

export const prerender = true;

export async function getStaticPaths() {
  const rawAllTemplates = await getLiveCollection("templates", {
    type: "cv_storefront_templates",
  });
  const allTemplateEntries = Array.isArray(rawAllTemplates)
    ? rawAllTemplates
    : (rawAllTemplates.entries ?? []);
  const allTemplates = allTemplateEntries.filter(({ data }) =>
    Boolean(data.slug || data.id),
  );

  return allTemplates.map((entry) => ({
    params: { slug: (entry.data.slug || entry.data.id) as string },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const rawPublishedTemplates = await getLiveCollection("templates", {
  type: "cv_storefront_templates",
});
const publishedTemplates = Array.isArray(rawPublishedTemplates)
  ? rawPublishedTemplates
  : (rawPublishedTemplates.entries ?? []);

const matchedEntry =
  Astro.props.entry ??
  publishedTemplates.find((item) => (item.data.slug || item.data.id) === slug);

if (!matchedEntry) {
  return Astro.redirect("/#templates");
}

const template = matchedEntry.data;
const totalTemplatesCount = publishedTemplates.length;
const cmsVersion = emdashStorefrontData.cms_version;

const templateSlug = template.slug || template.id;

const previewImageRecord =
  template.preview_image && typeof template.preview_image === "object"
    ? (template.preview_image as Record<string, unknown>)
    : {};

const previewMetaRecord =
  previewImageRecord.meta && typeof previewImageRecord.meta === "object"
    ? (previewImageRecord.meta as Record<string, unknown>)
    : undefined;

const storageKey =
  (typeof previewMetaRecord?.storageKey === "string" &&
    previewMetaRecord.storageKey) ||
  (typeof previewImageRecord.storageKey === "string" &&
    previewImageRecord.storageKey) ||
  (typeof previewImageRecord.id === "string" && previewImageRecord.id) ||
  "";

const previewSrc =
  typeof previewImageRecord.src === "string" &&
  previewImageRecord.src.length > 0
    ? previewImageRecord.src
    : typeof previewImageRecord.url === "string" &&
        previewImageRecord.url.length > 0
      ? previewImageRecord.url
      : typeof previewImageRecord.previewUrl === "string" &&
          previewImageRecord.previewUrl.length > 0
        ? previewImageRecord.previewUrl
        : storageKey
          ? `/_emdash/api/media/file/${storageKey}`
          : "";

const previewAlt =
  typeof previewImageRecord.alt === "string" &&
  previewImageRecord.alt.trim().length > 0
    ? previewImageRecord.alt
    : (template.preview_alt ?? template.title);

const swatchesTypefacesRecord =
  template.swatches_typefaces && typeof template.swatches_typefaces === "object"
    ? (template.swatches_typefaces as {
        swatches?: ColorSwatch[];
        typefaces?: string[];
      })
    : undefined;

const swatches: ColorSwatch[] = Array.isArray(swatchesTypefacesRecord?.swatches)
  ? swatchesTypefacesRecord.swatches
  : (template.swatches ?? []);

const typefaces: string[] = Array.isArray(swatchesTypefacesRecord?.typefaces)
  ? swatchesTypefacesRecord.typefaces
  : (template.typefaces ?? []);

const styleTag = template.style_tag ?? template.style;
const priceDisplay = template.price_display ?? `$${template.price}`;
const domNodesCount = template.dom_nodes_count ?? 0;
const routesIncluded = template.routes_included ?? ["/"];
const collectionSlug = template.emdash_collection ?? "cv_storefront_templates";
const featureBullet = template.feature_bullet ?? "Typed EmDash Content Layer";
---

<!doctype html>
<html lang="en" data-theme="dark" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${template.title}: ${template.subtitle}`}
    />
    <title>{template.title} // Creative Vertices Astro v7 Template</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("cv-theme");
        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.setAttribute("data-theme", savedTheme);
        }
      } catch {
        // Fall back to dark theme when storage is restricted in private browsing.
      }
    </script>
  </head>
  <body class="bg-[var(--cv-bg)] text-[var(--cv-text)] antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-[var(--cv-accent)] focus:bg-[var(--cv-bg)] focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-bold focus:text-[var(--cv-text)]"
    >
      Skip to main content
    </a>

    <NavBar
      totalTemplatesCount={totalTemplatesCount}
      bundlePrice={bundleDiscountPrice}
    />

    <div class="mx-auto max-w-7xl border-l border-r border-dashed border-gray-700/50">
      <main id="main-content">
        <!-- Breadcrumb & Archive Back-Link Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-dashed border-[var(--cv-rail)] px-4 py-4 sm:px-6 lg:px-8">
          <a
            href="/#templates"
            class="inline-flex min-h-11 items-center gap-2 font-mono text-xs font-semibold tracking-wider text-[var(--cv-text-muted)] transition-colors hover:text-[var(--cv-accent)]"
          >
            <span aria-hidden="true">&larr;</span>
            <span>BACK TO TEMPLATE ARCHIVE</span>
          </a>

          <div class="flex items-center gap-2 font-mono text-xs text-[var(--cv-text-muted)]">
            <span>COLLECTION // {collectionSlug}</span>
            <span aria-hidden="true">&middot;</span>
            <span class="text-[var(--cv-accent)]">{templateSlug}</span>
          </div>
        </div>

        <!-- Product Hero + Specifications Rail -->
        <section
          aria-labelledby="template-heading"
          class="border-b border-dashed border-[var(--cv-rail)]"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12">
            <!-- Left 8 Columns: Hero Header & Blueprint Preview Image -->
            <div class="border-b border-dashed border-[var(--cv-rail)] p-4 sm:p-6 lg:col-span-8 lg:border-r lg:border-b-0 lg:p-8">
              <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
                <span class="border border-[var(--cv-accent)] bg-[var(--cv-surface-elevated)] px-2.5 py-1 font-bold tracking-wider text-[var(--cv-accent)]">
                  {template.industry}
                </span>
                <span class="border border-[var(--cv-border-strong)] bg-[var(--cv-surface)] px-2.5 py-1 font-bold tracking-wider text-[var(--cv-text)]">
                  {styleTag}
                </span>
                {template.featured && (
                  <span class="border border-[#F5F6F8] bg-[#0A0B0E] px-2.5 py-1 font-semibold tracking-wider text-[#F5F6F8]">
                    FEATURED ARCHITECTURE
                  </span>
                )}
              </div>

              <h1
                id="template-heading"
                class="mt-4 text-3xl font-bold tracking-tight text-[var(--cv-text)] sm:text-4xl lg:text-5xl"
              >
                {template.title}
              </h1>

              <p class="mt-3 max-w-2xl text-base leading-relaxed text-[var(--cv-text-muted)] sm:text-lg">
                {template.subtitle}
              </p>

              <!-- Blueprint Preview Image Frame -->
              <div class="relative mt-8 border border-gray-800 bg-[var(--cv-surface)]">
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                ></span>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                ></span>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                ></span>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                ></span>

                <div class="overflow-hidden bg-[#090A0D]">
                  <img
                    src={previewSrc}
                    alt={previewAlt}
                    width="800"
                    height="500"
                    fetchpriority="high"
                    decoding="async"
                    class="aspect-video w-full object-cover object-top"
                  />
                </div>

                <div class="flex flex-wrap items-center justify-between gap-4 border-t border-dashed border-[var(--cv-border)] px-4 py-3 font-mono text-xs text-[var(--cv-text-muted)]">
                  <span>HIGHLIGHT // {featureBullet}</span>
                  <span>ASTRO v7.4 + TAILWIND CSS v4.3</span>
                </div>
              </div>
            </div>

            <!-- Right 4 Columns: Specifications Rail & Checkout Action -->
            <aside
              aria-label="Template specifications and licensing"
              class="flex flex-col justify-between p-4 sm:p-6 lg:col-span-4 lg:p-8"
            >
              <div>
                <div class="relative border border-gray-800 bg-[var(--cv-surface-elevated)] p-6">
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>

                  <div class="flex items-baseline justify-between border-b border-dashed border-[var(--cv-border)] pb-4">
                    <div>
                      <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
                        {template.tier} LICENSE
                      </p>
                      <p class="mt-1 font-mono text-xs text-[var(--cv-text-muted)]">
                        Unlimited Commercial Projects
                      </p>
                    </div>
                    <span class="font-mono text-3xl font-bold tracking-tight text-[var(--cv-text)]">
                      {priceDisplay}
                    </span>
                  </div>

                  <!-- Primary Specifications Rail: Price, Page Count, Style Tag -->
                  <dl class="mt-5 divide-y divide-dashed divide-[var(--cv-border)] font-mono text-xs">
                    <div class="flex items-center justify-between py-2.5">
                      <dt class="text-[var(--cv-text-muted)]">PRICE</dt>
                      <dd class="font-bold text-[var(--cv-text)]">
                        {priceDisplay} USD
                      </dd>
                    </div>
                    <div class="flex items-center justify-between py-2.5">
                      <dt class="text-[var(--cv-text-muted)]">PAGE COUNT</dt>
                      <dd class="font-bold text-[var(--cv-text)]">
                        {template.page_count} Pages
                      </dd>
                    </div>
                    <div class="flex items-center justify-between py-2.5">
                      <dt class="text-[var(--cv-text-muted)]">STYLE TAG</dt>
                      <dd class="border border-[var(--cv-border-strong)] bg-[var(--cv-surface)] px-2 py-0.5 font-bold text-[var(--cv-accent)]">
                        {styleTag}
                      </dd>
                    </div>
                    <div class="flex items-center justify-between py-2.5">
                      <dt class="text-[var(--cv-text-muted)]">CSS PAYLOAD</dt>
                      <dd class="font-bold text-[var(--cv-text)]">
                        {template.css_payload}
                      </dd>
                    </div>
                    <div class="flex items-center justify-between py-2.5">
                      <dt class="text-[var(--cv-text-muted)]">DOM NODES</dt>
                      <dd class="font-bold text-[var(--cv-text)]">
                        {domNodesCount} nodes
                      </dd>
                    </div>
                    <div class="flex items-center justify-between py-2.5">
                      <dt class="text-[var(--cv-text-muted)]">SECTOR</dt>
                      <dd class="font-bold text-[var(--cv-text)]">
                        {template.industry}
                      </dd>
                    </div>
                  </dl>

                  <button
                    type="button"
                    data-detail-add-cart
                    data-template-id={template.id}
                    data-template-title={template.title}
                    data-template-price={template.price}
                    class="mt-6 inline-flex min-h-11 w-full items-center justify-center border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-5 py-3 font-mono text-xs font-bold tracking-wider text-[var(--cv-accent-contrast)] transition-transform hover:-translate-y-0.5 active:translate-y-0"
                  >
                    Add to Cart ({priceDisplay})
                  </button>

                  <button
                    type="button"
                    data-detail-add-bundle
                    data-bundle-price={bundleDiscountPrice}
                    class="mt-3 inline-flex min-h-11 w-full items-center justify-center border border-[var(--cv-border-strong)] bg-[var(--cv-bg)] px-4 py-2.5 font-mono text-xs font-semibold text-[var(--cv-text)] transition-colors hover:border-[var(--cv-accent)] hover:text-[var(--cv-accent)]"
                  >
                    Or Unlock All {totalTemplatesCount} Templates ($
                    {bundleDiscountPrice})
                  </button>
                </div>

                <!-- Typography & Color Swatches Specification -->
                <div class="mt-6 border border-dashed border-[var(--cv-border)] bg-[var(--cv-surface)] p-5">
                  <h2 class="font-mono text-xs font-bold tracking-wider text-[var(--cv-text-muted)]">
                    DESIGN TOKENS &amp; TYPOGRAPHY
                  </h2>

                  {swatches.length > 0 && (
                    <div class="mt-4">
                      <p class="font-mono text-[11px] text-[var(--cv-text-muted)]">
                        VERIFIED COLOR SWATCHES
                      </p>
                      <ul class="mt-2 space-y-2 font-mono text-xs">
                        {swatches.map((swatch) => (
                          <li class="flex items-center gap-2.5">
                            <span
                              class="inline-block h-4 w-4 shrink-0 border border-[var(--cv-border-strong)]"
                              style={`background-color: ${swatch.hex};`}
                              aria-hidden="true"
                            />
                            <span class="text-[var(--cv-text)]">
                              {swatch.label}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {typefaces.length > 0 && (
                    <div class="mt-4 border-t border-dashed border-[var(--cv-border)] pt-4">
                      <p class="font-mono text-[11px] text-[var(--cv-text-muted)]">
                        SELF-HOSTED WOFF2 TYPEFACES
                      </p>
                      <p class="mt-1.5 font-mono text-xs font-bold text-[var(--cv-text)]">
                        {typefaces.join(" + ")}
                      </p>
                    </div>
                  )}

                  {routesIncluded.length > 0 && (
                    <div class="mt-4 border-t border-dashed border-[var(--cv-border)] pt-4">
                      <p class="font-mono text-[11px] text-[var(--cv-text-muted)]">
                        INCLUDED ROUTES &amp; SCHEMAS
                      </p>
                      <ul class="mt-2 flex flex-wrap gap-1.5 font-mono text-xs">
                        {routesIncluded.map((route) => (
                          <li class="border border-[var(--cv-border)] bg-[var(--cv-surface-elevated)] px-2.5 py-1 text-[var(--cv-text)]">
                            {route}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </aside>
          </div>
        </section>
      </main>

      <footer class="px-4 py-10 sm:px-6 lg:px-8">
        <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
          <div>
            <div class="flex items-center gap-2">
              <span
                class="inline-block h-2 w-2 bg-[var(--cv-accent)]"
                aria-hidden="true"
              ></span>
              <span class="text-sm font-bold text-[var(--cv-text)]">
                Creative Vertices
              </span>
              <span class="font-mono text-xs text-[var(--cv-text-muted)]">
                // {totalTemplatesCount} Verified Astro v7 Templates
              </span>
            </div>
            <p class="mt-1.5 font-mono text-xs text-[var(--cv-text-muted)]">
              Powered by {cmsVersion} &amp; Tailwind CSS v4. Zero third-party
              tracking scripts.
            </p>
          </div>

          <nav aria-label="Footer navigation">
            <ul class="flex flex-wrap items-center gap-6 font-mono text-xs">
              <li>
                <a
                  href="/#top"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  Storefront
                </a>
              </li>
              <li>
                <a
                  href="/#templates"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  Catalog
                </a>
              </li>
              <li>
                <a
                  href="/#architecture"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  Architecture
                </a>
              </li>
              <li>
                <a
                  href="/#bundle"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  All-Access
                </a>
              </li>
              <li>
                <a
                  href="/#faq"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  FAQ
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </footer>
    </div>

    <CartDrawer bundlePrice={bundleDiscountPrice} />
  </body>
</html>

<script>
  const addCartBtn = document.querySelector<HTMLButtonElement>(
    "[data-detail-add-cart]",
  );
  const addBundleBtn = document.querySelector<HTMLButtonElement>(
    "[data-detail-add-bundle]",
  );

  addCartBtn?.addEventListener("click", () => {
    const id = addCartBtn.dataset.templateId || "";
    const title = addCartBtn.dataset.templateTitle || "";
    const price = Number(addCartBtn.dataset.templatePrice || 0);

    window.dispatchEvent(
      new CustomEvent("cv:cart-add", {
        detail: { id, title, price },
      }),
    );
  });

  addBundleBtn?.addEventListener("click", () => {
    const price = Number(addBundleBtn.dataset.bundlePrice || 246);
    window.dispatchEvent(
      new CustomEvent("cv:cart-add", {
        detail: {
          id: "bundle-all-access",
          title: "All-Access Studio Bundle (All 8 Templates)",
          price,
        },
      }),
    );
  });
</script>
