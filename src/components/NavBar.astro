---
interface Props {
  totalTemplatesCount?: number;
  bundlePrice?: number;
}
---

<header class="sticky top-0 z-40 w-full border-b border-dashed border-[var(--cv-rail)] bg-[var(--cv-nav-bg)] backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl justify-between items-center border-l border-r border-dashed border-gray-700/50 px-4 py-3 sm:px-6 lg:px-8">
    <a
      href="#top"
      class="group inline-flex min-h-11 items-center gap-2.5 py-1 text-left focus-visible:outline-2"
    >
      <span
        class="inline-block h-2.5 w-2.5 shrink-0 bg-[var(--cv-accent)] transition-transform duration-150 group-hover:scale-125"
        aria-hidden="true"
      ></span>
      <span class="flex flex-col justify-center">
        <span class="text-sm font-bold leading-tight tracking-tight text-[var(--cv-text)] sm:text-base">
          Creative Vertices
        </span>
        <span class="font-mono text-[11px] leading-tight text-[var(--cv-text-muted)]">
          ASTRO v7 // EMDASH CMS
        </span>
      </span>
    </a>

    <div class="flex items-center gap-5 sm:gap-6">
      <cv-theme-toggle class="inline-flex items-center">
        <button
          type="button"
          data-theme-btn
          aria-label="Switch to light theme (currently dark)"
          class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-none border border-transparent p-2 text-gray-400 text-[var(--cv-text-muted)] transition-colors hover:border-[var(--cv-border)] hover:bg-[var(--cv-surface-hover)] hover:text-white hover:text-[var(--cv-text)] active:translate-y-px"
        >
          <span class="sr-only" data-theme-label>
            Switch color theme
          </span>
          <svg
            data-theme-icon="sun"
            aria-hidden="true"
            focusable="false"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="square"
            stroke-linejoin="miter"
            class="h-5 w-5"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"></path>
          </svg>
          <svg
            data-theme-icon="moon"
            aria-hidden="true"
            focusable="false"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="square"
            stroke-linejoin="miter"
            class="hidden h-5 w-5"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </cv-theme-toggle>

      <button
        type="button"
        data-cart-open-trigger
        aria-haspopup="dialog"
        aria-controls="cv-cart-dialog"
        class="inline-flex min-h-11 items-center justify-center rounded-none border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2 font-mono text-xs font-bold tracking-wider text-[var(--cv-accent-contrast)] transition-all hover:-translate-y-0.5 hover:border-[var(--cv-text)] hover:bg-[var(--cv-text)] hover:text-[var(--cv-bg)] active:translate-y-0 sm:px-5"
      >
        All Access
      </button>
    </div>
  </div>
</header>

<script>
  class CvThemeToggle extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector<HTMLButtonElement>("[data-theme-btn]");
      const label = this.querySelector<HTMLElement>("[data-theme-label]");
      const sunIcon = this.querySelector<SVGElement>('[data-theme-icon="sun"]');
      const moonIcon = this.querySelector<SVGElement>(
        '[data-theme-icon="moon"]',
      );
      if (!btn || !label) return;

      const syncUi = (theme: string) => {
        const isLight = theme === "light";
        const actionText = isLight
          ? "Switch to dark theme (currently light)"
          : "Switch to light theme (currently dark)";
        label.textContent = actionText;
        btn.setAttribute("aria-label", actionText);
        sunIcon?.classList.toggle("hidden", isLight);
        moonIcon?.classList.toggle("hidden", !isLight);
      };

      const current =
        document.documentElement.getAttribute("data-theme") || "dark";
      syncUi(current);

      btn.addEventListener("click", () => {
        const active =
          document.documentElement.getAttribute("data-theme") || "dark";
        const next = active === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("cv-theme", next);
        } catch {
          // Ignore storage restrictions in private browsing.
        }
        syncUi(next);
      });
    }
  }

  if (!customElements.get("cv-theme-toggle")) {
    customElements.define("cv-theme-toggle", CvThemeToggle);
  }
</script>
