---
import type { EmDashTemplateNode } from "../data/emdash-cms";
import TemplateCard from "./TemplateCard.astro";

interface Props {
  templates: EmDashTemplateNode[];
  cms_version?: string;
  collection_slug?: string;
}

const { templates, collection_slug = "cv_storefront_templates" } = Astro.props;

const totalCount = templates.length;

const industryCounts = templates.reduce(
  (acc, template) => {
    const industry = template.industry || "Uncategorized";
    acc[industry] = (acc[industry] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);

const sectorCategories = Object.entries(industryCounts)
  .map(([key, count]) => ({ key, label: key, count }))
  .sort((a, b) => b.count - a.count);
---

<section
  id="storefront"
  aria-labelledby="storefront-heading"
  class="border-b border-dashed border-[var(--cv-rail)]"
>
  <cv-storefront class="block" data-total-templates={totalCount}>
    <div class="flex flex-col justify-between gap-2 border-b border-dashed border-[var(--cv-rail)] px-4 py-5 sm:flex-row sm:items-baseline sm:px-6 lg:px-8">
      <h2
        id="storefront-heading"
        class="text-xl font-bold tracking-tight text-[var(--cv-text)] sm:text-2xl"
      >
        The Template Archive
      </h2>
      <p class="text-sm text-gray-400">
        Explore production-ready Astro architectures.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 lg:items-start">
      <aside
        aria-label="Template catalog filters"
        class="flex flex-col justify-between border-b border-dashed border-[var(--cv-rail)] p-4 sm:p-6 lg:col-span-3 lg:border-r lg:border-b-0 lg:p-8"
      >
        <div>
          <h3 class="font-mono text-xs font-bold tracking-wider uppercase text-[var(--cv-text-muted)]">
            BROWSE BY SECTOR OR SITE TYPE
          </h3>
          <ul class="mt-3 space-y-1" role="list">
            {sectorCategories.map((item, idx) => (
              <li>
                <button
                  type="button"
                  data-filter-industry={item.key}
                  aria-pressed={idx === 0 ? "true" : "false"}
                  class={`flex min-h-11 w-full items-center justify-between border-l-2 px-3 py-2 text-left text-sm transition-colors ${
                    idx === 0
                      ? "border-[var(--cv-accent)] bg-[var(--cv-surface-elevated)] font-bold text-[var(--cv-text)]"
                      : "border-transparent font-normal text-[var(--cv-text-muted)] hover:border-[var(--cv-border-strong)] hover:bg-[var(--cv-surface)] hover:text-[var(--cv-text)]"
                  }`}
                >
                  <span>{item.label}</span>
                  <span class="font-mono text-xs tabular-nums text-right text-[var(--cv-text-muted)]">
                    {item.count}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-8 border-t border-dashed border-[var(--cv-border)] pt-5">
          <div class="flex items-baseline justify-between font-mono text-xs">
            <span class="text-[var(--cv-text-muted)]">SHOWING</span>
            <span
              data-visible-count-summary
              class="font-bold tabular-nums text-[var(--cv-text)]"
            >
              {totalCount} / {totalCount} templates
            </span>
          </div>
          <button
            type="button"
            data-reset-filters
            class="mt-3 inline-flex min-h-11 w-full items-center justify-center border border-[var(--cv-border)] bg-[var(--cv-surface)] px-3 py-2 font-mono text-xs font-semibold text-[var(--cv-text)] transition-colors hover:border-[var(--cv-border-strong)] hover:bg-[var(--cv-surface-hover)]"
          >
            Reset All Filters
          </button>
        </div>
      </aside>

      <div class="p-4 sm:p-6 lg:col-span-9 lg:p-8">
        <div
          data-state-panel="loading"
          hidden
          role="status"
          aria-live="polite"
          class="cv-vertex-card p-8 text-center"
        >
          <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
            HYDRATING EMDASH CONTENT LAYER...
          </p>
          <p class="mt-2 text-sm text-[var(--cv-text-muted)]">
            Fetching typed template definitions and verifying SHA-256 asset
            checksums from
            <code>{collection_slug}</code>.
          </p>
          <div class="mt-6 flex justify-center">
            <button
              type="button"
              data-restore-live
              class="min-h-11 border border-[var(--cv-border-strong)] bg-[var(--cv-surface-elevated)] px-4 py-2 font-mono text-xs font-semibold text-[var(--cv-text)] hover:border-[var(--cv-accent)]"
            >
              Cancel Sync &amp; Show Cached Snapshot
            </button>
          </div>
        </div>

        <div
          data-state-panel="error"
          hidden
          role="alert"
          class="cv-vertex-card border-[var(--cv-accent)] p-8"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
                EMDASH_ENDPOINT_UNREACHABLE (HTTP 503)
              </p>
              <h3 class="mt-1 text-lg font-bold text-[var(--cv-text)]">
                Remote CMS collection failed to respond within 2,500ms.
              </h3>
              <p class="mt-1 text-sm text-[var(--cv-text-muted)]">
                Verify your <code>EMDASH_READ_TOKEN</code> environment variable
                or switch back to the verified build-time snapshot.
              </p>
            </div>
            <button
              type="button"
              data-restore-live
              class="min-h-11 shrink-0 border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2.5 font-mono text-xs font-bold text-[var(--cv-accent-contrast)]"
            >
              Load Verified Snapshot
            </button>
          </div>
        </div>

        <div
          data-state-panel="empty"
          hidden
          role="status"
          aria-live="polite"
          class="cv-vertex-card p-8"
        >
          <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
            0 MATCHING TEMPLATES
          </p>
          <h3 class="mt-1 text-lg font-bold text-[var(--cv-text)]">
            No templates match the active sector filter.
          </h3>
          <p class="mt-1 text-sm text-[var(--cv-text-muted)]">
            Clear the active filter constraints to restore all {totalCount}{" "}
            templates in the archive.
          </p>
          <div class="mt-5">
            <button
              type="button"
              data-reset-filters
              class="min-h-11 border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2 font-mono text-xs font-bold text-[var(--cv-accent-contrast)]"
            >
              Restore All {totalCount} Templates
            </button>
          </div>
        </div>

        <cv-grid-reveal class="block">
          <div
            data-templates-grid
            class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-6 lg:gap-6"
          >
            {templates.map((template, index) => (
              <TemplateCard
                template={template}
                isTopRowTwoCol={index < 2}
                isPriorityImage={index === 0}
              />
            ))}
          </div>
        </cv-grid-reveal>
      </div>
    </div>
  </cv-storefront>
</section>

<script>
  import gsap from "gsap";

  const SECTOR_TEMPLATE_MAP: Record<string, string[]> = {
    "Trades & Industry": [
      "tpl-vertex-01",
      "tpl-vertex-02",
      "tpl-vertex-03",
      "tpl-vertex-04",
      "tpl-vertex-05",
      "tpl-vertex-06",
      "tpl-vertex-07",
      "tpl-vertex-08",
    ],
    "Health & Practice": ["tpl-vertex-02", "tpl-vertex-06", "tpl-vertex-07"],
    "Online Shop": ["tpl-vertex-01", "tpl-vertex-04", "tpl-vertex-08"],
    "Landing Page": [
      "tpl-vertex-01",
      "tpl-vertex-02",
      "tpl-vertex-04",
      "tpl-vertex-07",
    ],
    "Professional Services": [
      "tpl-vertex-01",
      "tpl-vertex-05",
      "tpl-vertex-06",
      "tpl-vertex-08",
    ],
    "Food & Drink": ["tpl-vertex-04", "tpl-vertex-05", "tpl-vertex-08"],
    "Studios & Agencies": ["tpl-vertex-01", "tpl-vertex-05", "tpl-vertex-08"],
    "Software & SaaS": ["tpl-vertex-02", "tpl-vertex-06", "tpl-vertex-07"],
    "Retail & Product": ["tpl-vertex-04", "tpl-vertex-08"],
    "Travel & Leisure": ["tpl-vertex-03", "tpl-vertex-05"],
    "Personal & Writing": ["tpl-vertex-03", "tpl-vertex-06", "tpl-vertex-07"],
    "Arts & Culture": ["tpl-vertex-05", "tpl-vertex-08"],
    Blog: ["tpl-vertex-03", "tpl-vertex-06", "tpl-vertex-07"],
  };

  class CvGridReveal extends HTMLElement {
    private observer: IntersectionObserver | null = null;

    connectedCallback() {
      const cards = this.querySelectorAll<HTMLElement>("article");
      if (!cards.length || this.dataset.revealed === "true") return;

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (prefersReducedMotion) {
        this.dataset.revealed = "true";
        gsap.set(cards, { clearProps: "all" });
        return;
      }

      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && this.dataset.revealed !== "true") {
              this.dataset.revealed = "true";
              this.observer?.disconnect();
              this.observer = null;

              gsap.from(cards, {
                opacity: 0,
                y: 20,
                duration: 0.4,
                stagger: 0.05,
                ease: "power2.out",
                clearProps: "all",
              });
            }
          });
        },
        { threshold: 0.1 },
      );

      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.observer = null;
    }
  }

  class CvStorefront extends HTMLElement {
    private activeIndustry = "Trades & Industry";
    private cmsState: "ready" | "loading" | "empty" | "error" = "ready";

    connectedCallback() {
      const industryButtons = this.querySelectorAll<HTMLButtonElement>(
        "[data-filter-industry]",
      );
      const resetButtons = this.querySelectorAll<HTMLButtonElement>(
        "[data-reset-filters]",
      );
      const restoreLiveButtons = this.querySelectorAll<HTMLButtonElement>(
        "[data-restore-live]",
      );

      industryButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          this.activeIndustry =
            btn.dataset.filterIndustry || "Trades & Industry";
          this.cmsState = "ready";
          this.updateFilterButtonStyles(industryButtons, this.activeIndustry);
          this.applyFilters();
        });
      });

      resetButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          this.activeIndustry = "Trades & Industry";
          this.cmsState = "ready";
          this.updateFilterButtonStyles(industryButtons, "Trades & Industry");
          this.applyFilters();
        });
      });

      restoreLiveButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          this.cmsState = "ready";
          this.applyFilters();
        });
      });
    }

    private updateFilterButtonStyles(
      buttons: NodeListOf<HTMLButtonElement>,
      activeValue: string,
    ) {
      buttons.forEach((btn) => {
        const isSelected = btn.dataset.filterIndustry === activeValue;
        btn.setAttribute("aria-pressed", String(isSelected));
        btn.classList.toggle("border-[var(--cv-accent)]", isSelected);
        btn.classList.toggle("bg-[var(--cv-surface-elevated)]", isSelected);
        btn.classList.toggle("font-bold", isSelected);
        btn.classList.toggle("text-[var(--cv-text)]", isSelected);
        btn.classList.toggle("border-transparent", !isSelected);
        btn.classList.toggle("font-normal", !isSelected);
        btn.classList.toggle("text-[var(--cv-text-muted)]", !isSelected);
      });
    }

    private applyFilters() {
      const cards = this.querySelectorAll<HTMLElement>("[data-template-card]");
      const articles = this.querySelectorAll<HTMLElement>(
        "[data-template-card] article",
      );
      const gridReveal = this.querySelector<HTMLElement>("cv-grid-reveal");
      const grid = this.querySelector<HTMLElement>("[data-templates-grid]");
      const loadingPanel = this.querySelector<HTMLElement>(
        '[data-state-panel="loading"]',
      );
      const errorPanel = this.querySelector<HTMLElement>(
        '[data-state-panel="error"]',
      );
      const emptyPanel = this.querySelector<HTMLElement>(
        '[data-state-panel="empty"]',
      );
      const countSummary = this.querySelector<HTMLElement>(
        "[data-visible-count-summary]",
      );
      const total = Number(this.dataset.totalTemplates || cards.length);

      // Zero transition time on filter updates to provide instant terminal-style feedback.
      if (gridReveal) {
        gridReveal.dataset.revealed = "true";
      }
      gsap.killTweensOf(articles);
      gsap.set(articles, { clearProps: "all" });

      if (this.cmsState === "loading") {
        grid?.setAttribute("hidden", "");
        loadingPanel?.removeAttribute("hidden");
        errorPanel?.setAttribute("hidden", "");
        emptyPanel?.setAttribute("hidden", "");
        return;
      }

      if (this.cmsState === "error") {
        grid?.setAttribute("hidden", "");
        loadingPanel?.setAttribute("hidden", "");
        errorPanel?.removeAttribute("hidden");
        emptyPanel?.setAttribute("hidden", "");
        return;
      }

      if (this.cmsState === "empty") {
        grid?.setAttribute("hidden", "");
        loadingPanel?.setAttribute("hidden", "");
        errorPanel?.setAttribute("hidden", "");
        emptyPanel?.removeAttribute("hidden");
        return;
      }

      loadingPanel?.setAttribute("hidden", "");
      errorPanel?.setAttribute("hidden", "");

      const allowedIds = SECTOR_TEMPLATE_MAP[this.activeIndustry] || [];
      let visibleIndex = 0;

      cards.forEach((card) => {
        const cardId = card.dataset.id || "";
        const cardIndustry = card.dataset.industry || "";
        const isVisible =
          this.activeIndustry === "Trades & Industry" ||
          cardIndustry === this.activeIndustry ||
          allowedIds.includes(cardId);

        if (isVisible) {
          card.removeAttribute("hidden");
          // Keep top 2 visible cards spanning 2 columns (lg:col-span-3) and the rest spanning 3 columns (lg:col-span-2).
          const isTopTwo = visibleIndex < 2;
          card.classList.toggle("lg:col-span-3", isTopTwo);
          card.classList.toggle("sm:col-span-2", isTopTwo);
          card.classList.toggle("lg:col-span-2", !isTopTwo);
          card.classList.toggle("sm:col-span-1", !isTopTwo);
          visibleIndex++;
        } else {
          card.setAttribute("hidden", "");
        }
      });

      if (countSummary) {
        countSummary.textContent = `${visibleIndex} / ${total} templates`;
      }

      if (visibleIndex === 0) {
        grid?.setAttribute("hidden", "");
        emptyPanel?.removeAttribute("hidden");
      } else {
        grid?.removeAttribute("hidden");
        emptyPanel?.setAttribute("hidden", "");
      }
    }
  }

  if (!customElements.get("cv-grid-reveal")) {
    customElements.define("cv-grid-reveal", CvGridReveal);
  }
  if (!customElements.get("cv-storefront")) {
    customElements.define("cv-storefront", CvStorefront);
  }
</script>
