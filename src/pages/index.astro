---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import CartDrawer from "../components/CartDrawer.astro";
import {
  emdashStorefrontData,
  totalCatalogRetailValue,
  bundleDiscountPrice,
} from "../data/emdash-cms";

const { templates, benefits, faqs, cmsVersion } = emdashStorefrontData;

const totalTemplatesCount = templates.length;

const sectorCategories = [
  { key: "trades-industry", label: "Trades & industry", count: 14 },
  { key: "health-practice", label: "Health & practice", count: 8 },
  { key: "online-shop", label: "Online shop", count: 7 },
  { key: "landing-page", label: "Landing page", count: 7 },
  { key: "professional-services", label: "Professional services", count: 7 },
  { key: "food-drink", label: "Food & drink", count: 6 },
  { key: "studios-agencies", label: "Studios & agencies", count: 6 },
  { key: "software-saas", label: "Software & SaaS", count: 6 },
  { key: "retail-product", label: "Retail & product", count: 5 },
  { key: "travel-leisure", label: "Travel & leisure", count: 5 },
  { key: "personal-writing", label: "Personal & writing", count: 4 },
  { key: "arts-culture", label: "Arts & culture", count: 3 },
  { key: "blog", label: "Blog", count: 3 },
];

const specModalPayload = templates.map(
  ({
    id,
    title,
    subtitle,
    emdashCollection,
    styleTag,
    cssPayloadKb,
    domNodesCount,
    routesIncluded,
    price,
    priceDisplay,
  }) => ({
    id,
    title,
    subtitle,
    emdashCollection,
    styleTag,
    cssPayloadKb,
    domNodesCount,
    routesIncluded,
    price,
    priceDisplay,
  }),
);
---

<!doctype html>
<html lang="en" data-theme="dark" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Creative Vertices: Code-driven digital template storefront built with Astro v7, Tailwind CSS v4, and EmDash CMS."
    />
    <title>Creative Vertices // Astro v7 &amp; EmDash CMS Template Storefront</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("cv-theme");
        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.setAttribute("data-theme", savedTheme);
        }
      } catch {
        // Fall back to dark theme when storage is restricted in private browsing.
      }
    </script>
  </head>
  <body class="bg-[var(--cv-bg)] text-[var(--cv-text)] antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-[var(--cv-accent)] focus:bg-[var(--cv-bg)] focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-bold focus:text-[var(--cv-text)]"
    >
      Skip to main content
    </a>

    <NavBar
      totalTemplatesCount={totalTemplatesCount}
      bundlePrice={bundleDiscountPrice}
    />

    <div class="mx-auto max-w-7xl border-l border-r border-dashed border-gray-700/50">
      <main id="main-content">
        <section
          aria-labelledby="hero-heading"
          class="border-b border-dashed border-[var(--cv-rail)] px-4 py-14 sm:px-6 md:py-20 lg:px-8 lg:py-24"
        >
          <div class="max-w-4xl text-left">
            <h1
              id="hero-heading"
              class="text-5xl md:text-7xl font-semibold tracking-tight text-[var(--cv-text)] leading-[1.06]"
            >
              Architectural Astro Templates. Built for the Modern Web.
            </h1>

            <p class="text-gray-400 text-lg md:text-xl leading-relaxed mt-6 max-w-[65ch]">
              Skip the boilerplate. Ship lightning-fast, visually stunning
              websites with distraction-free Astro v7 codebases. Fully typed,
              GDPR-compliant, and wired for EmDash CMS.
            </p>

            <div
              class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-gray-500 uppercase tracking-widest"
              aria-label="Technical specifications"
            >
              <span>ASTRO v7.4</span>
              <span aria-hidden="true">&middot;</span>
              <span>TAILWIND v4.3</span>
              <span aria-hidden="true">&middot;</span>
              <span>EMDASH CMS v3.8</span>
              <span aria-hidden="true">&middot;</span>
              <span>0 EXTERNAL REQUESTS</span>
            </div>
          </div>
        </section>

        <section
          id="templates"
          aria-labelledby="directory-heading"
          class="border-b border-dashed border-[var(--cv-rail)]"
        >
          <cv-storefront
            class="block"
            data-total-templates={totalTemplatesCount}
          >
            <div class="border-b border-dashed border-[var(--cv-border)] px-4 py-6 sm:px-6 lg:px-8">
              <h2
                id="directory-heading"
                class="text-2xl font-bold tracking-tight text-[var(--cv-text)] sm:text-3xl"
              >
                The Template Archive
              </h2>
              <p class="mt-1.5 text-base text-[var(--cv-text-muted)]">
                Explore production-ready Astro architectures.
              </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12">
              <aside
                aria-label="Template filters"
                class="border-b border-dashed border-[var(--cv-border)] p-4 sm:p-6 lg:col-span-3 lg:border-r lg:border-b-0 lg:p-8"
              >
                <div class="lg:sticky lg:top-20">
                  <div>
                    <h3 class="font-mono text-xs font-bold tracking-wider uppercase text-[var(--cv-text-muted)]">
                      BROWSE BY SECTOR OR SITE TYPE
                    </h3>
                    <ul class="mt-3 space-y-0.5" role="list">
                      {sectorCategories.map((cat, idx) => (
                        <li>
                          <button
                            type="button"
                            data-filter-industry={cat.key}
                            aria-pressed={idx === 0 ? "true" : "false"}
                            class={`flex min-h-11 w-full items-center justify-between border-l-2 px-3 py-2 text-left text-sm transition-colors ${
                              idx === 0
                                ? "border-[var(--cv-accent)] bg-[var(--cv-surface-elevated)] font-bold text-[var(--cv-text)]"
                                : "border-transparent font-normal text-[var(--cv-text-muted)] hover:border-[var(--cv-border-strong)] hover:bg-[var(--cv-surface)] hover:text-[var(--cv-text)]"
                            }`}
                          >
                            <span class="truncate pr-2">{cat.label}</span>
                            <span class="font-mono text-xs tabular-nums text-[var(--cv-text-muted)]">
                              {cat.count}
                            </span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="mt-6 border-t border-dashed border-[var(--cv-border)] pt-5">
                    <div class="flex items-center justify-between font-mono text-xs">
                      <span class="text-[var(--cv-text-muted)]">SHOWING</span>
                      <span
                        data-visible-count-summary
                        aria-live="polite"
                        class="font-bold text-[var(--cv-text)]"
                      >
                        {totalTemplatesCount} / {totalTemplatesCount} templates
                      </span>
                    </div>
                    <button
                      type="button"
                      data-reset-filters
                      class="mt-3 flex min-h-11 w-full items-center justify-center border border-[var(--cv-border)] bg-[var(--cv-surface)] px-3 py-2 font-mono text-xs font-semibold text-[var(--cv-text-muted)] transition-colors hover:border-[var(--cv-border-strong)] hover:text-[var(--cv-text)]"
                    >
                      Reset Filter Constraints
                    </button>
                  </div>
                </div>
              </aside>

              <div class="p-4 sm:p-6 lg:col-span-9 lg:p-8">
                <div
                  data-state-panel="loading"
                  hidden
                  aria-live="polite"
                  class="space-y-6"
                >
                  <div class="relative border border-gray-800 bg-[var(--cv-surface)] p-4 font-mono text-xs text-[var(--cv-text-muted)]">
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                    ></span>
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                    ></span>
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                    ></span>
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                    ></span>
                    [EMDASH_SYNC] Fetching Content Layer collection nodes from
                    edge worker...
                  </div>
                  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-6">
                    <div class="relative border border-gray-800 bg-[var(--cv-surface)] p-5 sm:col-span-2 lg:col-span-3">
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <div class="aspect-video w-full animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                      <div class="mt-4 h-5 w-2/3 animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                      <div class="mt-2 h-4 w-1/2 animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                    </div>
                    <div class="relative border border-gray-800 bg-[var(--cv-surface)] p-5 sm:col-span-2 lg:col-span-3">
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <div class="aspect-video w-full animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                      <div class="mt-4 h-5 w-3/4 animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                      <div class="mt-2 h-4 w-1/3 animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                    </div>
                  </div>
                </div>

                <div
                  data-state-panel="error"
                  hidden
                  role="alert"
                  class="cv-vertex-card relative border border-gray-800 bg-[var(--cv-surface)] p-6 sm:p-8"
                >
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                    <div>
                      <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-danger)]">
                        ERR_EMDASH_EDGE_TIMEOUT // HTTP 504
                      </p>
                      <h3 class="mt-1 text-lg font-bold text-[var(--cv-text)]">
                        Remote CMS collection failed to respond within 2,500ms.
                      </h3>
                      <p class="mt-1 text-sm text-[var(--cv-text-muted)]">
                        Verify your <code>EMDASH_READ_TOKEN</code> environment
                        variable or switch back to the verified build-time
                        snapshot.
                      </p>
                    </div>
                    <button
                      type="button"
                      data-restore-live
                      class="min-h-11 shrink-0 border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2.5 font-mono text-xs font-bold text-[var(--cv-accent-contrast)]"
                    >
                      Load Verified Snapshot
                    </button>
                  </div>
                </div>

                <div
                  data-state-panel="empty"
                  hidden
                  role="status"
                  aria-live="polite"
                  class="cv-vertex-card relative border border-gray-800 bg-[var(--cv-surface)] p-8"
                >
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
                    0 MATCHING TEMPLATES
                  </p>
                  <h3 class="mt-1 text-lg font-bold text-[var(--cv-text)]">
                    No templates match the active sector filter.
                  </h3>
                  <p class="mt-1 text-sm text-[var(--cv-text-muted)]">
                    Clear the active filter constraints to restore all{" "}
                    {totalTemplatesCount} templates in the archive.
                  </p>
                  <div class="mt-5">
                    <button
                      type="button"
                      data-reset-filters
                      class="min-h-11 border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2 font-mono text-xs font-bold text-[var(--cv-accent-contrast)]"
                    >
                      Restore All {totalTemplatesCount} Templates
                    </button>
                  </div>
                </div>

                <cv-grid-reveal class="block">
                  <div
                    data-templates-grid
                    class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-6 lg:gap-6"
                  >
                    {templates.map((template, index) => (
                      <a
                        href={`#${template.slug}`}
                        data-template-card
                        data-inspect-template={template.id}
                        data-id={template.id}
                        data-title={template.title}
                        data-price-type={
                          template.price === 0 ? "free" : "premium"
                        }
                        data-price-value={template.price}
                        data-industry={template.industry}
                        data-grid-role={index < 2 ? "top-2col" : "body-3col"}
                        class={`cv-vertex-card group relative block border border-gray-800 bg-[var(--cv-surface)] ${
                          index < 2
                            ? "col-span-1 sm:col-span-2 lg:col-span-3"
                            : "col-span-1 sm:col-span-1 lg:col-span-2"
                        }`}
                      >
                        <span
                          aria-hidden="true"
                          class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                        ></span>
                        <span
                          aria-hidden="true"
                          class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                        ></span>
                        <span
                          aria-hidden="true"
                          class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                        ></span>
                        <span
                          aria-hidden="true"
                          class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                        ></span>

                        <article
                          id={template.slug}
                          class="flex h-full flex-col justify-between"
                        >
                          <div class="relative overflow-hidden border-b border-[var(--cv-border)] bg-[#090A0D]">
                            <img
                              src={template.previewSvgDataUri}
                              alt={template.previewAlt}
                              width="800"
                              height="450"
                              fetchpriority={index === 0 ? "high" : undefined}
                              loading={index === 0 ? undefined : "lazy"}
                              decoding="async"
                              class="aspect-video w-full object-cover transition-transform duration-200 group-hover:scale-[1.015]"
                            />

                            <div class="pointer-events-none absolute top-3 left-3 z-10 flex items-center gap-1.5">
                              {template.featured ? (
                                <span class="border border-[#F5F6F8] bg-[#0A0B0E]/90 px-2.5 py-1 font-mono text-[11px] font-semibold tracking-wider text-[#F5F6F8]">
                                  FEATURED
                                </span>
                              ) : (
                                <span class="border border-[#A3AAB8]/60 bg-[#0A0B0E]/90 px-2 py-1 font-mono text-[11px] text-[#A3AAB8]">
                                  {template.emdashCollection}
                                </span>
                              )}
                            </div>

                            <div class="pointer-events-none absolute top-3 right-3 z-10">
                              {template.tier === "PREMIUM" ? (
                                <span class="inline-block bg-[#FF6A1A] px-2.5 py-1 font-mono text-[11px] font-bold tracking-wider text-[#0A0B0E]">
                                  PREMIUM
                                </span>
                              ) : (
                                <span class="inline-block bg-[#F5F6F8] px-2.5 py-1 font-mono text-[11px] font-bold tracking-wider text-[#0A0B0E]">
                                  FREE
                                </span>
                              )}
                            </div>
                          </div>

                          <div class="flex flex-1 flex-col justify-between border-b border-dashed border-[var(--cv-border)] px-4 py-3.5">
                            <div class="flex items-start justify-between gap-3">
                              <h3 class="text-base font-bold tracking-tight text-[var(--cv-text)] group-hover:text-[var(--cv-accent)] transition-colors">
                                {template.title}
                              </h3>
                              <span class="inline-block shrink-0 border border-[var(--cv-border-strong)] bg-[var(--cv-surface-elevated)] px-2 py-0.5 font-mono text-[11px] font-bold tracking-wider text-[var(--cv-text)]">
                                {template.styleTag}
                              </span>
                            </div>
                            <p class="mt-1.5 text-sm leading-snug text-[var(--cv-text-muted)]">
                              {template.subtitle}
                            </p>
                          </div>

                          <div class="flex items-center justify-between gap-3 bg-[var(--cv-surface)] px-4 py-3 min-w-0">
                            <div class="flex items-center gap-2 min-w-0 flex-1 overflow-hidden">
                              <div
                                class="flex shrink-0 items-center -space-x-1"
                                role="group"
                                aria-label={`Color palette for ${template.title}`}
                              >
                                {template.swatches.map((swatch) => (
                                  <span
                                    class="inline-block h-4 w-4 border border-[var(--cv-border-strong)]"
                                    style={`background-color: ${swatch.hex};`}
                                    title={swatch.label}
                                    aria-label={swatch.label}
                                  />
                                ))}
                              </div>
                              <span
                                class="block min-w-0 flex-1 truncate font-mono text-xs text-[var(--cv-text-muted)]"
                                title={template.typefaces.join(" + ")}
                              >
                                {template.typefaces.join(" + ")}
                              </span>
                            </div>

                            <div class="flex shrink-0 items-baseline gap-2 font-mono">
                              <span class="text-sm font-bold text-[var(--cv-text)]">
                                {template.priceDisplay}
                              </span>
                              <span class="text-xs text-[var(--cv-text-muted)]">
                                {template.pageCount} pages
                              </span>
                            </div>
                          </div>
                        </article>
                      </a>
                    ))}
                  </div>
                </cv-grid-reveal>
              </div>
            </div>

            <dialog
              data-spec-dialog
              aria-labelledby="spec-dialog-title"
              class="m-auto w-full max-w-xl border border-[var(--cv-border-strong)] bg-[var(--cv-surface)] p-0 text-[var(--cv-text)] backdrop:bg-black/75"
            >
              <div class="p-6">
                <div class="flex items-start justify-between gap-4 border-b border-dashed border-[var(--cv-border)] pb-4">
                  <div>
                    <p
                      data-spec-collection
                      class="font-mono text-xs font-semibold text-[var(--cv-accent)]"
                    >
                      EMDASH SCHEMA SPECIFICATION
                    </p>
                    <h3
                      id="spec-dialog-title"
                      data-spec-title
                      class="mt-1 text-xl font-bold"
                    >
                      Template Specification
                    </h3>
                  </div>
                  <button
                    type="button"
                    data-close-spec-dialog
                    aria-label="Close specification dialog"
                    class="min-h-11 min-w-11 border border-[var(--cv-border)] bg-[var(--cv-surface-elevated)] px-3 py-1.5 font-mono text-xs font-bold text-[var(--cv-text)] hover:border-[var(--cv-accent)]"
                  >
                    ESC
                  </button>
                </div>

                <p
                  data-spec-subtitle
                  class="mt-4 text-sm text-[var(--cv-text-muted)]"
                ></p>

                <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-b border-dashed border-[var(--cv-border)] py-4 font-mono text-xs sm:grid-cols-3">
                  <div>
                    <dt class="text-[var(--cv-text-muted)]">ASTRO ENGINE</dt>
                    <dd class="mt-1 font-bold text-[var(--cv-text)]">
                      v7.4 Strict
                    </dd>
                  </div>
                  <div>
                    <dt class="text-[var(--cv-text-muted)]">CSS PAYLOAD</dt>
                    <dd
                      data-spec-css
                      class="mt-1 font-bold text-[var(--cv-text)]"
                    ></dd>
                  </div>
                  <div>
                    <dt class="text-[var(--cv-text-muted)]">DOM NODES</dt>
                    <dd
                      data-spec-dom
                      class="mt-1 font-bold text-[var(--cv-text)]"
                    ></dd>
                  </div>
                </dl>

                <div class="mt-4">
                  <h4 class="font-mono text-xs font-bold text-[var(--cv-text-muted)]">
                    INCLUDED ROUTES &amp; SCHEMAS
                  </h4>
                  <ul
                    data-spec-routes
                    class="mt-2 flex flex-wrap gap-1.5 font-mono text-xs"
                  ></ul>
                </div>

                <div class="mt-6 flex items-center justify-end gap-3">
                  <button
                    type="button"
                    data-close-spec-dialog
