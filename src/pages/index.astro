---
import { getLiveCollection } from "astro:content";
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import CartDrawer from "../components/CartDrawer.astro";
import TemplateCard from "../components/TemplateCard.astro";
import {
  emdashStorefrontData,
  totalCatalogRetailValue,
  bundleDiscountPrice,
} from "../data/emdash-cms";

const rawTemplates = await getLiveCollection("templates", {
  type: "cv_storefront_templates",
});
const templateEntries = Array.isArray(rawTemplates)
  ? rawTemplates
  : (rawTemplates.entries ?? []);
const templates = templateEntries.map((t) => t.data);
const { benefits, faqs, cms_version } = emdashStorefrontData;

const totalTemplatesCount = templates.length;

const industryCounts = templates.reduce(
  (acc, template) => {
    const industry = template.industry || "Uncategorized";
    acc[industry] = (acc[industry] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);

const sectorCategories = Object.entries(industryCounts)
  .map(([key, count]) => ({ key, label: key, count }))
  .sort((a, b) => b.count - a.count);
---

<!doctype html>
<html lang="en" data-theme="dark" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Creative Vertices: Code-driven digital template storefront built with Astro v7, Tailwind CSS v4, and EmDash CMS."
    />
    <title>Creative Vertices // Astro v7 &amp; EmDash CMS Template Storefront</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("cv-theme");
        if (savedTheme === "light" || savedTheme === "dark") {
          document.documentElement.setAttribute("data-theme", savedTheme);
        }
      } catch {
        // Fall back to dark theme when storage is restricted in private browsing.
      }
    </script>
  </head>
  <body class="bg-[var(--cv-bg)] text-[var(--cv-text)] antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:border focus:border-[var(--cv-accent)] focus:bg-[var(--cv-bg)] focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-bold focus:text-[var(--cv-text)]"
    >
      Skip to main content
    </a>

    <NavBar
      totalTemplatesCount={totalTemplatesCount}
      bundlePrice={bundleDiscountPrice}
    />

    <div class="mx-auto max-w-7xl border-l border-r border-dashed border-gray-700/50">
      <main id="main-content">
        <section
          aria-labelledby="hero-heading"
          class="border-b border-dashed border-[var(--cv-rail)] px-4 py-14 sm:px-6 md:py-20 lg:px-8 lg:py-24"
        >
          <div class="max-w-4xl text-left">
            <h1
              id="hero-heading"
              class="text-5xl md:text-7xl font-semibold tracking-tight text-[var(--cv-text)] leading-[1.06]"
            >
              Architectural Astro Templates. Built for the Modern Web.
            </h1>

            <p class="text-gray-400 text-lg md:text-xl leading-relaxed mt-6 max-w-[65ch]">
              Skip the boilerplate. Ship lightning-fast, visually stunning
              websites with distraction-free Astro v7 codebases. Fully typed,
              GDPR-compliant, and wired for EmDash CMS.
            </p>

            <div
              class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-gray-500 uppercase tracking-widest"
              aria-label="Technical specifications"
            >
              <span>ASTRO v7.4</span>
              <span aria-hidden="true">&middot;</span>
              <span>TAILWIND v4.3</span>
              <span aria-hidden="true">&middot;</span>
              <span>EMDASH CMS v3.8</span>
              <span aria-hidden="true">&middot;</span>
              <span>0 EXTERNAL REQUESTS</span>
            </div>
          </div>
        </section>

        <section
          id="templates"
          aria-labelledby="directory-heading"
          class="border-b border-dashed border-[var(--cv-rail)]"
        >
          <cv-storefront
            class="block"
            data-total-templates={totalTemplatesCount}
          >
            <div class="border-b border-dashed border-[var(--cv-border)] px-4 py-6 sm:px-6 lg:px-8">
              <h2
                id="directory-heading"
                class="text-2xl font-bold tracking-tight text-[var(--cv-text)] sm:text-3xl"
              >
                The Template Archive
              </h2>
              <p class="mt-1.5 text-base text-[var(--cv-text-muted)]">
                Explore production-ready Astro architectures.
              </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12">
              <aside
                aria-label="Template filters"
                class="border-b border-dashed border-[var(--cv-border)] p-4 sm:p-6 lg:col-span-3 lg:border-r lg:border-b-0 lg:p-8"
              >
                <div class="lg:sticky lg:top-20">
                  <div>
                    <h3 class="font-mono text-xs font-bold tracking-wider uppercase text-[var(--cv-text-muted)]">
                      BROWSE BY SECTOR OR SITE TYPE
                    </h3>
                    <ul class="mt-3 space-y-0.5" role="list">
                      {sectorCategories.map((cat, idx) => (
                        <li>
                          <button
                            type="button"
                            data-filter-industry={cat.key}
                            aria-pressed={idx === 0 ? "true" : "false"}
                            class={`flex min-h-11 w-full items-center justify-between border-l-2 px-3 py-2 text-left text-sm transition-colors ${
                              idx === 0
                                ? "border-[var(--cv-accent)] bg-[var(--cv-surface-elevated)] font-bold text-[var(--cv-text)]"
                                : "border-transparent font-normal text-[var(--cv-text-muted)] hover:border-[var(--cv-border-strong)] hover:bg-[var(--cv-surface)] hover:text-[var(--cv-text)]"
                            }`}
                          >
                            <span class="truncate pr-2">{cat.label}</span>
                            <span class="font-mono text-xs tabular-nums text-[var(--cv-text-muted)]">
                              {cat.count}
                            </span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="mt-6 border-t border-dashed border-[var(--cv-border)] pt-5">
                    <div class="flex items-center justify-between font-mono text-xs">
                      <span class="text-[var(--cv-text-muted)]">SHOWING</span>
                      <span
                        data-visible-count-summary
                        aria-live="polite"
                        class="font-bold text-[var(--cv-text)]"
                      >
                        {totalTemplatesCount} / {totalTemplatesCount} templates
                      </span>
                    </div>
                    <button
                      type="button"
                      data-reset-filters
                      class="mt-3 flex min-h-11 w-full items-center justify-center border border-[var(--cv-border)] bg-[var(--cv-surface)] px-3 py-2 font-mono text-xs font-semibold text-[var(--cv-text-muted)] transition-colors hover:border-[var(--cv-border-strong)] hover:text-[var(--cv-text)]"
                    >
                      Reset Filter Constraints
                    </button>
                  </div>
                </div>
              </aside>

              <div class="p-4 sm:p-6 lg:col-span-9 lg:p-8">
                <div
                  data-state-panel="loading"
                  hidden
                  aria-live="polite"
                  class="space-y-6"
                >
                  <div class="relative border border-gray-800 bg-[var(--cv-surface)] p-4 font-mono text-xs text-[var(--cv-text-muted)]">
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                    ></span>
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                    ></span>
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                    ></span>
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                    ></span>
                    [EMDASH_SYNC] Fetching Content Layer collection nodes from
                    edge worker...
                  </div>
                  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-6">
                    <div class="relative border border-gray-800 bg-[var(--cv-surface)] p-5 sm:col-span-2 lg:col-span-3">
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <div class="aspect-video w-full animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                      <div class="mt-4 h-5 w-2/3 animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                      <div class="mt-2 h-4 w-1/2 animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                    </div>
                    <div class="relative border border-gray-800 bg-[var(--cv-surface)] p-5 sm:col-span-2 lg:col-span-3">
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                      ></span>
                      <div class="aspect-video w-full animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                      <div class="mt-4 h-5 w-3/4 animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                      <div class="mt-2 h-4 w-1/3 animate-pulse bg-[var(--cv-surface-elevated)]"></div>
                    </div>
                  </div>
                </div>

                <div
                  data-state-panel="error"
                  hidden
                  role="alert"
                  class="cv-vertex-card relative border border-gray-800 bg-[var(--cv-surface)] p-6 sm:p-8"
                >
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                    <div>
                      <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-danger)]">
                        ERR_EMDASH_EDGE_TIMEOUT // HTTP 504
                      </p>
                      <h3 class="mt-1 text-lg font-bold text-[var(--cv-text)]">
                        Remote CMS collection failed to respond within 2,500ms.
                      </h3>
                      <p class="mt-1 text-sm text-[var(--cv-text-muted)]">
                        Verify your <code>EMDASH_READ_TOKEN</code> environment
                        variable or switch back to the verified build-time
                        snapshot.
                      </p>
                    </div>
                    <button
                      type="button"
                      data-restore-live
                      class="min-h-11 shrink-0 border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2.5 font-mono text-xs font-bold text-[var(--cv-accent-contrast)]"
                    >
                      Load Verified Snapshot
                    </button>
                  </div>
                </div>

                <div
                  data-state-panel="empty"
                  hidden
                  role="status"
                  aria-live="polite"
                  class="cv-vertex-card relative border border-gray-800 bg-[var(--cv-surface)] p-8"
                >
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                  ></span>
                  <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
                    0 MATCHING TEMPLATES
                  </p>
                  <h3 class="mt-1 text-lg font-bold text-[var(--cv-text)]">
                    No templates match the active sector filter.
                  </h3>
                  <p class="mt-1 text-sm text-[var(--cv-text-muted)]">
                    Clear the active filter constraints to restore all{" "}
                    {totalTemplatesCount} templates in the archive.
                  </p>
                  <div class="mt-5">
                    <button
                      type="button"
                      data-reset-filters
                      class="min-h-11 border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2 font-mono text-xs font-bold text-[var(--cv-accent-contrast)]"
                    >
                      Restore All {totalTemplatesCount} Templates
                    </button>
                  </div>
                </div>

                <cv-grid-reveal class="block">
                  <div
                    data-templates-grid
                    class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-6 lg:gap-6"
                  >
                    {templates.map((template, index) => (
                      <TemplateCard
                        template={template}
                        isTopRowTwoCol={index < 2}
                        isPriorityImage={index === 0}
                      />
                    ))}
                  </div>
                </cv-grid-reveal>
              </div>
            </div>
          </cv-storefront>
        </section>

        <section
          id="architecture"
          aria-labelledby="why-heading"
          class="border-b border-dashed border-[var(--cv-rail)] px-4 py-12 sm:px-6 lg:px-8 lg:py-16"
        >
          <div class="flex flex-col items-center border-b border-dashed border-[var(--cv-border)] pb-8 text-center">
            <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
              ARCHITECTURAL GUARANTEES
            </p>
            <h2
              id="why-heading"
              class="mt-2 text-2xl font-bold tracking-tight text-[var(--cv-text)] sm:text-3xl"
            >
              Engineered for Performance
            </h2>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--cv-text-muted)]">
              Every template in the catalog is audited against strict build-time
              constraints: zero external network dependencies, scoped Web
              Components, and typed EmDash CMS schemas.
            </p>
          </div>

          <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 lg:gap-6">
            {benefits.map((benefit) => (
              <article
                class={`cv-vertex-card relative flex flex-col justify-between border border-gray-800 p-5 sm:p-6 ${
                  benefit.emphasized
                    ? "bg-[var(--cv-surface-elevated)]"
                    : "bg-[var(--cv-surface)]"
                }`}
              >
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                ></span>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                ></span>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                ></span>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
                ></span>

                <div>
                  <div class="flex items-center font-mono text-xs">
                    <span class="font-bold text-[var(--cv-accent)]">
                      {benefit.code_ref}
                    </span>
                  </div>

                  <h3 class="mt-4 text-lg font-bold tracking-tight text-[var(--cv-text)]">
                    {benefit.title}
                  </h3>

                  <p class="mt-2.5 text-sm leading-relaxed text-[var(--cv-text-muted)]">
                    {benefit.summary}
                  </p>
                </div>

                <div class="mt-6 flex items-baseline justify-between border-t border-dashed border-[var(--cv-border)] pt-4 font-mono text-xs">
                  <span class="text-[var(--cv-text-muted)]">
                    {benefit.metric_label}
                  </span>
                  <span class="font-bold text-[var(--cv-text)]">
                    {benefit.metric_value}
                  </span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section
          id="bundle"
          aria-labelledby="bundle-heading"
          class="border-b border-dashed border-[var(--cv-rail)] px-4 py-12 sm:px-6 lg:px-8 lg:py-16"
        >
          <div class="cv-vertex-card relative border border-gray-800 bg-[var(--cv-surface-elevated)] p-6 sm:p-8 lg:p-10">
            <span
              aria-hidden="true"
              class="pointer-events-none absolute top-0 left-0 z-20 -mt-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
            ></span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute top-0 right-0 z-20 -mt-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
            ></span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute bottom-0 left-0 z-20 -mb-1 -ml-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
            ></span>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute bottom-0 right-0 z-20 -mb-1 -mr-1 h-2 w-2 bg-[var(--cv-bg)] border border-orange-500"
            ></span>

            <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
              <div class="lg:col-span-8">
                <div class="inline-flex items-center gap-2 border border-[var(--cv-accent)] bg-[var(--cv-bg)] px-3 py-1 font-mono text-xs font-bold text-[var(--cv-accent)]">
                  <span>STUDIO ALL-ACCESS PASS</span>
                  <span>//</span>
                  <span>{totalTemplatesCount} TEMPLATES INCLUDED</span>
                </div>

                <h2
                  id="bundle-heading"
                  class="mt-4 text-2xl font-bold tracking-tight text-[var(--cv-text)] sm:text-3xl lg:text-4xl"
                >
                  50% Off: One Purchase, All Templates.
                </h2>

                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--cv-text-muted)] sm:text-base">
                  Unlock the complete Creative Vertices repository: all{" "}
                  {totalTemplatesCount} Astro v7 + Tailwind CSS v4 templates,
                  typed EmDash CMS content schemas, self-hosted variable font
                  packs, and unlimited commercial project rights.
                </p>

                <dl class="mt-6 grid grid-cols-1 gap-6 border-t border-dashed border-[var(--cv-border)] pt-5 font-mono text-xs sm:grid-cols-2">
                  <div>
                    <dt class="text-[var(--cv-text-muted)]">TOTAL VALUE</dt>
                    <dd class="mt-1 text-sm font-bold line-through text-[var(--cv-text-muted)]">
                      ${totalCatalogRetailValue} USD
                    </dd>
                  </div>
                  <div>
                    <dt class="text-[var(--cv-text-muted)]">LICENSE SCOPE</dt>
                    <dd class="mt-1 text-sm font-bold text-[var(--cv-text)]">
                      Unlimited Commercial Domains
                    </dd>
                  </div>
                </dl>
              </div>

              <div class="flex flex-col justify-between border border-dashed border-[var(--cv-border-strong)] bg-[var(--cv-bg)] p-6 sm:p-8 lg:col-span-4">
                <div>
                  <div class="flex items-baseline justify-between font-mono">
                    <span class="text-xs text-[var(--cv-text-muted)]">
                      ONE-TIME ARCHIVE LICENSE
                    </span>
                    <span class="text-2xl font-bold text-[var(--cv-text)]">
                      ${bundleDiscountPrice}
                    </span>
                  </div>
                  <ul class="mt-5 space-y-3 font-mono text-xs text-[var(--cv-text-muted)]">
                    <li class="flex items-center gap-2">
                      <span
                        class="h-1.5 w-1.5 bg-[var(--cv-bg)] border border-orange-500"
                        aria-hidden="true"
                      ></span>
                      <span>Full Git monorepo + EmDash seed files</span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span
                        class="h-1.5 w-1.5 bg-[var(--cv-bg)] border border-orange-500"
                        aria-hidden="true"
                      ></span>
                      <span>Astro v7.4 + Tailwind v4.3 strict config</span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span
                        class="h-1.5 w-1.5 bg-[var(--cv-bg)] border border-orange-500"
                        aria-hidden="true"
                      ></span>
                      <span>Perpetual agency &amp; client license</span>
                    </li>
                  </ul>
                </div>

                <button
                  type="button"
                  data-add-bundle-to-cart
                  data-bundle-price={bundleDiscountPrice}
                  class="mt-6 inline-flex min-h-11 w-full items-center justify-center border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-5 py-3 font-mono text-xs font-bold tracking-wider text-[var(--cv-accent-contrast)] transition-transform hover:-translate-y-0.5 active:translate-y-0"
                >
                  Get Instant Access
                </button>
              </div>
            </div>
          </div>
        </section>

        <section
          id="faq"
          aria-labelledby="faq-heading"
          class="border-b border-dashed border-[var(--cv-rail)] px-4 py-12 sm:px-6 lg:px-8 lg:py-16"
        >
          <cv-accordion class="block">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
              <div class="lg:col-span-4">
                <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
                  TECHNICAL DOCUMENTATION // FAQ
                </p>
                <h2
                  id="faq-heading"
                  class="mt-2 text-2xl font-bold tracking-tight text-[var(--cv-text)] sm:text-3xl"
                >
                  Architecture &amp; Licensing Questions
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-[var(--cv-text-muted)]">
                  Specific answers regarding EmDash Content Layer
                  synchronization, Tailwind CSS v4 stylesheets, native Web
                  Component hydration, and agency client rights.
                </p>
