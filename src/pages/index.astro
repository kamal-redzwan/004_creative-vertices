              <div class="lg:col-span-8">
                {faqs.map((item, idx) => (
                  <details
                    data-faq-item
                    data-expanded={idx === 0 ? "true" : "false"}
                    open={idx === 0}
                    class="group border-b border-gray-800 pb-6 mb-6 last:mb-0"
                  >
                    <summary class="flex min-h-11 list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
                      <div class="flex flex-col gap-1 text-left">
                        <span class="font-mono text-[11px] font-bold tracking-wider text-[var(--cv-accent)]">
                          0{idx + 1} // {item.category}
                        </span>
                        <span class="text-base font-bold text-[var(--cv-text)]">
                          {item.question}
                        </span>
                      </div>
                      <span
                        aria-hidden="true"
                        class="inline-flex shrink-0 items-center justify-center text-orange-500"
                      >
                        <svg
                          data-icon-plus
                          class={`h-5 w-5 ${idx === 0 ? "hidden" : "block"}`}
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="square"
                        >
                          <path d="M12 5v14M5 12h14" />
                        </svg>
                        <svg
                          data-icon-cross
                          class={`h-5 w-5 ${idx === 0 ? "block" : "hidden"}`}
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="square"
                        >
                          <path d="M6 6l12 12M18 6L6 18" />
                        </svg>
                      </span>
                    </summary>
                    <div
                      data-faq-body
                      class="mt-3 pr-8 text-sm leading-relaxed text-[var(--cv-text-muted)]"
                    >
                      <p>{item.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </cv-accordion>
        </section>
      </main>

      <footer class="px-4 py-10 sm:px-6 lg:px-8">
        <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
          <div>
            <div class="flex items-center gap-2">
              <span
                class="inline-block h-2 w-2 bg-[var(--cv-accent)]"
                aria-hidden="true"
              ></span>
              <span class="text-sm font-bold text-[var(--cv-text)]">
                Creative Vertices
              </span>
              <span class="font-mono text-xs text-[var(--cv-text-muted)]">
                // {totalTemplatesCount} Verified Astro v7 Templates
              </span>
            </div>
            <p class="mt-1.5 font-mono text-xs text-[var(--cv-text-muted)]">
              Powered by {cms_version} &amp; Tailwind CSS v4. Zero third-party
              tracking scripts.
            </p>
          </div>

          <nav aria-label="Footer navigation">
            <ul class="flex flex-wrap items-center gap-6 font-mono text-xs">
              <li>
                <a
                  href="#top"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  Top &uarr;
                </a>
              </li>
              <li>
                <a
                  href="#templates"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  Catalog
                </a>
              </li>
              <li>
                <a
                  href="#architecture"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  Architecture
                </a>
              </li>
              <li>
                <a
                  href="#bundle"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  All-Access
                </a>
              </li>
              <li>
                <a
                  href="#faq"
                  class="inline-flex min-h-11 items-center text-gray-400 hover:text-white transition-colors"
                >
                  FAQ
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </footer>
    </div>

    <CartDrawer bundlePrice={bundleDiscountPrice} />
  </body>
</html>

<script>
  import gsap from "gsap";

  const SECTOR_TEMPLATE_MAP: Record<string, string[]> = {
    "Trades & Industry": [
      "tpl-vertex-01",
      "tpl-vertex-02",
      "tpl-vertex-03",
      "tpl-vertex-04",
      "tpl-vertex-05",
      "tpl-vertex-06",
      "tpl-vertex-07",
      "tpl-vertex-08",
    ],
    "Health & Practice": ["tpl-vertex-02", "tpl-vertex-06", "tpl-vertex-07"],
    "Online Shop": ["tpl-vertex-01", "tpl-vertex-04", "tpl-vertex-08"],
    "Landing Page": [
      "tpl-vertex-01",
      "tpl-vertex-02",
      "tpl-vertex-04",
      "tpl-vertex-07",
    ],
    "Professional Services": [
      "tpl-vertex-01",
      "tpl-vertex-05",
      "tpl-vertex-06",
      "tpl-vertex-08",
    ],
    "Food & Drink": ["tpl-vertex-04", "tpl-vertex-05", "tpl-vertex-08"],
    "Studios & Agencies": ["tpl-vertex-01", "tpl-vertex-05", "tpl-vertex-08"],
    "Software & SaaS": ["tpl-vertex-02", "tpl-vertex-06", "tpl-vertex-07"],
    "Retail & Product": ["tpl-vertex-04", "tpl-vertex-08"],
    "Travel & Leisure": ["tpl-vertex-03", "tpl-vertex-05"],
    "Personal & Writing": ["tpl-vertex-03", "tpl-vertex-06", "tpl-vertex-07"],
    "Arts & Culture": ["tpl-vertex-05", "tpl-vertex-08"],
    Blog: ["tpl-vertex-03", "tpl-vertex-06", "tpl-vertex-07"],
  };

  class CvGridReveal extends HTMLElement {
    private observer: IntersectionObserver | null = null;

    connectedCallback() {
      const cards = this.querySelectorAll<HTMLElement>("article");
      if (!cards.length || this.dataset.revealed === "true") return;

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (prefersReducedMotion) {
        this.dataset.revealed = "true";
        gsap.set(cards, { clearProps: "all" });
        return;
      }

      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && this.dataset.revealed !== "true") {
              this.dataset.revealed = "true";
              this.observer?.disconnect();
              this.observer = null;

              gsap.from(cards, {
                opacity: 0,
                y: 20,
                duration: 0.4,
                stagger: 0.05,
                ease: "power2.out",
                clearProps: "all",
              });
            }
          });
        },
        { threshold: 0.1 },
      );

      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.observer = null;
    }
  }

  class CvStorefront extends HTMLElement {
    private activeIndustry = "Trades & Industry";
    private cmsState: "ready" | "loading" | "empty" | "error" = "ready";

    connectedCallback() {
      const industryButtons = this.querySelectorAll<HTMLButtonElement>(
        "[data-filter-industry]",
      );
      const resetButtons = this.querySelectorAll<HTMLButtonElement>(
        "[data-reset-filters]",
      );
      const restoreLiveButtons = this.querySelectorAll<HTMLButtonElement>(
        "[data-restore-live]",
      );

      industryButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          this.activeIndustry =
            btn.dataset.filterIndustry || "Trades & Industry";
          this.cmsState = "ready";
          this.updateFilterButtonStyles(industryButtons, this.activeIndustry);
          this.applyFilters();
        });
      });

      resetButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          this.activeIndustry = "Trades & Industry";
          this.cmsState = "ready";
          this.updateFilterButtonStyles(industryButtons, "Trades & Industry");
          this.applyFilters();
        });
      });

      restoreLiveButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          this.cmsState = "ready";
          this.applyFilters();
        });
      });
    }

    private updateFilterButtonStyles(
      buttons: NodeListOf<HTMLButtonElement>,
      activeValue: string,
    ) {
      buttons.forEach((btn) => {
        const isSelected = btn.dataset.filterIndustry === activeValue;
        btn.setAttribute("aria-pressed", String(isSelected));
        btn.classList.toggle("border-[var(--cv-accent)]", isSelected);
        btn.classList.toggle("bg-[var(--cv-surface-elevated)]", isSelected);
        btn.classList.toggle("font-bold", isSelected);
        btn.classList.toggle("text-[var(--cv-text)]", isSelected);
        btn.classList.toggle("border-transparent", !isSelected);
        btn.classList.toggle("font-normal", !isSelected);
        btn.classList.toggle("text-[var(--cv-text-muted)]", !isSelected);
      });
    }

    private applyFilters() {
      const cards = this.querySelectorAll<HTMLElement>("[data-template-card]");
      const articles = this.querySelectorAll<HTMLElement>(
        "[data-template-card] article",
      );
      const gridReveal = this.querySelector<HTMLElement>("cv-grid-reveal");
      const grid = this.querySelector<HTMLElement>("[data-templates-grid]");
      const loadingPanel = this.querySelector<HTMLElement>(
        '[data-state-panel="loading"]',
      );
      const errorPanel = this.querySelector<HTMLElement>(
        '[data-state-panel="error"]',
      );
      const emptyPanel = this.querySelector<HTMLElement>(
        '[data-state-panel="empty"]',
      );
      const countSummary = this.querySelector<HTMLElement>(
        "[data-visible-count-summary]",
      );
      const total = Number(this.dataset.totalTemplates || cards.length);

      // Zero transition time on filter updates to provide instant terminal-style feedback.
      if (gridReveal) {
        gridReveal.dataset.revealed = "true";
      }
      gsap.killTweensOf(articles);
      gsap.set(articles, { clearProps: "all" });

      if (this.cmsState === "loading") {
        grid?.setAttribute("hidden", "");
        loadingPanel?.removeAttribute("hidden");
        errorPanel?.setAttribute("hidden", "");
        emptyPanel?.setAttribute("hidden", "");
        return;
      }

      if (this.cmsState === "error") {
        grid?.setAttribute("hidden", "");
        loadingPanel?.setAttribute("hidden", "");
        errorPanel?.removeAttribute("hidden");
        emptyPanel?.setAttribute("hidden", "");
        return;
      }

      if (this.cmsState === "empty") {
        grid?.setAttribute("hidden", "");
        loadingPanel?.setAttribute("hidden", "");
        errorPanel?.setAttribute("hidden", "");
        emptyPanel?.removeAttribute("hidden");
        return;
      }

      loadingPanel?.setAttribute("hidden", "");
      errorPanel?.setAttribute("hidden", "");

      const allowedIds = SECTOR_TEMPLATE_MAP[this.activeIndustry] || [];
      let visibleIndex = 0;

      cards.forEach((card) => {
        const cardId = card.dataset.id || "";
        const cardIndustry = card.dataset.industry || "";
        const isVisible =
          this.activeIndustry === "Trades & Industry" ||
          cardIndustry === this.activeIndustry ||
          allowedIds.includes(cardId);

        if (isVisible) {
          card.removeAttribute("hidden");
          // Keep top 2 visible cards spanning 2 columns (lg:col-span-3) and the rest spanning 3 columns (lg:col-span-2).
          const isTopTwo = visibleIndex < 2;
          card.classList.toggle("lg:col-span-3", isTopTwo);
          card.classList.toggle("sm:col-span-2", isTopTwo);
          card.classList.toggle("lg:col-span-2", !isTopTwo);
          card.classList.toggle("sm:col-span-1", !isTopTwo);
          visibleIndex++;
        } else {
          card.setAttribute("hidden", "");
        }
      });

      if (countSummary) {
        countSummary.textContent = `${visibleIndex} / ${total} templates`;
      }

      if (visibleIndex === 0) {
        grid?.setAttribute("hidden", "");
        emptyPanel?.removeAttribute("hidden");
      } else {
        grid?.removeAttribute("hidden");
        emptyPanel?.setAttribute("hidden", "");
      }
    }
  }

  class CvAccordion extends HTMLElement {
    private animations = new WeakMap<HTMLDetailsElement, Animation>();

    connectedCallback() {
      const detailsList =
        this.querySelectorAll<HTMLDetailsElement>("[data-faq-item]");

      detailsList.forEach((details) => {
        const summary = details.querySelector<HTMLElement>("summary");
        if (!summary) return;

        this.syncIconState(details, details.hasAttribute("open"));

        summary.addEventListener("click", (event) => {
          event.preventDefault();

          const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          const isCurrentlyExpanded = details.dataset.expanded === "true";

          if (isCurrentlyExpanded) {
            this.closeItem(details, summary, prefersReducedMotion);
          } else {
            // Smoothly close any other open FAQ item before/while opening the newly clicked item.
            detailsList.forEach((otherDetails) => {
              if (
                otherDetails !== details &&
                (otherDetails.dataset.expanded === "true" ||
                  otherDetails.hasAttribute("open"))
              ) {
                const otherSummary =
                  otherDetails.querySelector<HTMLElement>("summary");
                if (otherSummary) {
                  this.closeItem(
                    otherDetails,
                    otherSummary,
                    prefersReducedMotion,
                  );
                }
              }
            });

            this.openItem(details, summary, prefersReducedMotion);
          }
        });
      });
    }

    private syncIconState(details: HTMLDetailsElement, isExpanded: boolean) {
      details.dataset.expanded = isExpanded ? "true" : "false";
      const plusIcon = details.querySelector<SVGElement>("[data-icon-plus]");
      const crossIcon = details.querySelector<SVGElement>("[data-icon-cross]");
      if (plusIcon) {
        plusIcon.classList.toggle("hidden", isExpanded);
        plusIcon.classList.toggle("block", !isExpanded);
      }
      if (crossIcon) {
        crossIcon.classList.toggle("hidden", !isExpanded);
        crossIcon.classList.toggle("block", isExpanded);
      }
    }

    private cancelExistingAnimation(details: HTMLDetailsElement) {
      const existing = this.animations.get(details);
      if (existing) {
        existing.cancel();
        this.animations.delete(details);
      }
    }

    private openItem(
      details: HTMLDetailsElement,
      summary: HTMLElement,
      reducedMotion: boolean,
    ) {
      this.cancelExistingAnimation(details);

      const startHeight = details.offsetHeight;
      details.setAttribute("open", "");
      this.syncIconState(details, true);

      if (reducedMotion) {
        details.style.height = "";
        details.style.overflow = "";
        return;
      }

      const endHeight = details.offsetHeight;
      details.style.overflow = "hidden";

      const animation = details.animate(
        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
        {
          duration: 240,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
        },
      );

      this.animations.set(details, animation);

      animation.onfinish = () => {
        details.style.height = "";
        details.style.overflow = "";
        this.animations.delete(details);
      };

      animation.oncancel = () => {
        details.style.height = "";
        details.style.overflow = "";
      };
    }

    private closeItem(
      details: HTMLDetailsElement,
      summary: HTMLElement,
      reducedMotion: boolean,
    ) {
      this.cancelExistingAnimation(details);
      this.syncIconState(details, false);

      if (reducedMotion) {
        details.removeAttribute("open");
        details.style.height = "";
        details.style.overflow = "";
        return;
      }

      const startHeight = details.offsetHeight;
      const computedStyle = window.getComputedStyle(details);
      const paddingBottom = parseFloat(computedStyle.paddingBottom) || 0;
      const borderBottom = parseFloat(computedStyle.borderBottomWidth) || 0;
      const endHeight = summary.offsetHeight + paddingBottom + borderBottom;

      details.style.overflow = "hidden";

      const animation = details.animate(
        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
        {
          duration: 220,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
        },
      );

      this.animations.set(details, animation);

      animation.onfinish = () => {
        details.removeAttribute("open");
        details.style.height = "";
        details.style.overflow = "";
        this.animations.delete(details);
      };

      animation.oncancel = () => {
        details.style.height = "";
        details.style.overflow = "";
      };
    }
  }

  const bundleButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-add-bundle-to-cart]",
  );
  bundleButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const price = Number(btn.dataset.bundlePrice || 246);
      window.dispatchEvent(
        new CustomEvent("cv:cart-add", {
          detail: {
            id: "bundle-all-access",
            title: "All-Access Studio Bundle (All 8 Templates)",
            price,
          },
        }),
      );
    });
  });

  if (!customElements.get("cv-grid-reveal")) {
    customElements.define("cv-grid-reveal", CvGridReveal);
  }
  if (!customElements.get("cv-storefront")) {
    customElements.define("cv-storefront", CvStorefront);
  }
  if (!customElements.get("cv-accordion")) {
    customElements.define("cv-accordion", CvAccordion);
  }
</script>
