---
import type { EmDashTemplateNode } from '../data/emdash-cms';
import TemplateCard from './TemplateCard.astro';

interface Props {
  templates: EmDashTemplateNode[];
  cmsVersion: string;
  collectionSlug: string;
}

const { templates, cmsVersion, collectionSlug } = Astro.props;

const totalCount = templates.length;
const freeCount = templates.filter((t) => t.price === 0).length;
const premiumCount = templates.filter((t) => t.price > 0).length;

const industryCategories = [
  { key: 'all', label: 'All industries', count: totalCount },
  {
    key: 'studios-agencies',
    label: 'Studios & agencies',
    count: templates.filter((t) => t.industry === 'studios-agencies').length,
  },
  {
    key: 'software-saas',
    label: 'Software & SaaS',
    count: templates.filter((t) => t.industry === 'software-saas').length,
  },
  {
    key: 'personal-writing',
    label: 'Personal & writing',
    count: templates.filter((t) => t.industry === 'personal-writing').length,
  },
  {
    key: 'architecture-hardware',
    label: 'Architecture & hardware',
    count: templates.filter((t) => t.industry === 'architecture-hardware').length,
  },
  {
    key: 'editorial-docs',
    label: 'Editorial & docs',
    count: templates.filter((t) => t.industry === 'editorial-docs').length,
  },
];

const priceCategories = [
  { key: 'all', label: 'All templates', count: totalCount },
  { key: 'free', label: 'Free ($0)', count: freeCount },
  { key: 'premium', label: 'Premium', count: premiumCount },
];
---

<section
  id="storefront"
  aria-labelledby="storefront-heading"
  class="border-b border-dashed border-[var(--cv-rail)]"
>
  <cv-storefront class="block" data-total-templates={totalCount}>
    <!-- Section Header Bar -->
    <div
      class="flex flex-col justify-between gap-3 border-b border-dashed border-[var(--cv-rail)] px-4 py-5 sm:flex-row sm:items-center sm:px-6 lg:px-8"
    >
      <div>
        <h2
          id="storefront-heading"
          class="text-xl font-bold tracking-tight text-[var(--cv-text)] sm:text-2xl"
        >
          EmDash Template Directory
        </h2>
        <p class="mt-0.5 font-mono text-xs text-[var(--cv-text-muted)]">
          COLLECTION: <code>{collectionSlug}</code> // {cmsVersion}
        </p>
      </div>

      <!-- CMS Feed State Switcher (Verifies R-27 Ready / Loading / Empty / Error states) -->
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="CMS Feed State">
        <span class="font-mono text-xs text-[var(--cv-text-muted)]">CMS STATE:</span>
        <button
          type="button"
          data-cms-state-btn="ready"
          aria-pressed="true"
          class="min-h-11 border border-[var(--cv-accent)] bg-[var(--cv-surface-elevated)] px-3 py-1.5 font-mono text-xs font-semibold text-[var(--cv-text)]"
        >
          Live ({totalCount})
        </button>
        <button
          type="button"
          data-cms-state-btn="loading"
          aria-pressed="false"
          class="min-h-11 border border-[var(--cv-border)] bg-[var(--cv-surface)] px-3 py-1.5 font-mono text-xs text-[var(--cv-text-muted)] hover:border-[var(--cv-border-strong)] hover:text-[var(--cv-text)]"
        >
          Syncing
        </button>
        <button
          type="button"
          data-cms-state-btn="empty"
          aria-pressed="false"
          class="min-h-11 border border-[var(--cv-border)] bg-[var(--cv-surface)] px-3 py-1.5 font-mono text-xs text-[var(--cv-text-muted)] hover:border-[var(--cv-border-strong)] hover:text-[var(--cv-text)]"
        >
          Empty
        </button>
        <button
          type="button"
          data-cms-state-btn="error"
          aria-pressed="false"
          class="min-h-11 border border-[var(--cv-border)] bg-[var(--cv-surface)] px-3 py-1.5 font-mono text-xs text-[var(--cv-text-muted)] hover:border-[var(--cv-border-strong)] hover:text-[var(--cv-text)]"
        >
          Offline Error
        </button>
      </div>
    </div>

    <!-- Split Layout: 25% Sidebar (3 of 12 cols) and 75% Main Content Grid (9 of 12 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12">
      <!-- 25% Minimal Sidebar -->
      <aside
        aria-label="Template catalog filters"
        class="flex flex-col justify-between border-b border-dashed border-[var(--cv-rail)] p-4 sm:p-6 lg:col-span-3 lg:border-r lg:border-b-0"
      >
        <div class="space-y-7">
          <!-- Keyword Filter Input with Explicit Label -->
          <div>
            <label
              for="cv-template-search"
              class="block font-mono text-xs font-bold tracking-wider text-[var(--cv-text)]"
            >
              QUERY SCHEMA
            </label>
            <div class="mt-2 flex items-center gap-1.5">
              <input
                id="cv-template-search"
                type="search"
                data-search-input
                placeholder="Filter by title or stack..."
                class="min-h-11 w-full border border-[var(--cv-border)] bg-[var(--cv-surface)] px-3 py-2 font-mono text-xs text-[var(--cv-text)] placeholder:text-[var(--cv-text-muted)] focus:border-[var(--cv-accent)]"
              />
            </div>
          </div>

          <!-- PRICE Filter List -->
          <div>
            <h3 class="font-mono text-xs font-bold tracking-wider text-[var(--cv-text-muted)]">
              PRICE
            </h3>
            <ul class="mt-2.5 space-y-1" role="list">
              {
                priceCategories.map((item, idx) => (
                  <li>
                    <button
                      type="button"
                      data-filter-price={item.key}
                      aria-pressed={idx === 0 ? 'true' : 'false'}
                      class={`flex min-h-11 w-full items-center justify-between border-l-2 px-3 py-2 text-left text-sm transition-colors ${
                        idx === 0
                          ? 'border-[var(--cv-accent)] bg-[var(--cv-surface-elevated)] font-bold text-[var(--cv-text)]'
                          : 'border-transparent font-normal text-[var(--cv-text-muted)] hover:bg-[var(--cv-surface)] hover:text-[var(--cv-text)]'
                      }`}
                    >
                      <span>{item.label}</span>
                      <span class="font-mono text-xs tabular-nums text-[var(--cv-text-muted)]">
                        {item.count}
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- INDUSTRY Filter List -->
          <div>
            <h3 class="font-mono text-xs font-bold tracking-wider text-[var(--cv-text-muted)]">
              INDUSTRY
            </h3>
            <ul class="mt-2.5 space-y-1" role="list">
              {
                industryCategories.map((item, idx) => (
                  <li>
                    <button
                      type="button"
                      data-filter-industry={item.key}
                      aria-pressed={idx === 0 ? 'true' : 'false'}
                      class={`flex min-h-11 w-full items-center justify-between border-l-2 px-3 py-2 text-left text-sm transition-colors ${
                        idx === 0
                          ? 'border-[var(--cv-accent)] bg-[var(--cv-surface-elevated)] font-bold text-[var(--cv-text)]'
                          : 'border-transparent font-normal text-[var(--cv-text-muted)] hover:bg-[var(--cv-surface)] hover:text-[var(--cv-text)]'
                      }`}
                    >
                      <span>{item.label}</span>
                      <span class="font-mono text-xs tabular-nums text-[var(--cv-text-muted)]">
                        {item.count}
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Bottom Total Count Indicator & Reset Action -->
        <div class="mt-8 border-t border-dashed border-[var(--cv-border)] pt-5">
          <div class="flex items-baseline justify-between font-mono text-xs">
            <span class="text-[var(--cv-text-muted)]">ACTIVE NODES</span>
            <span data-visible-count-summary class="font-bold tabular-nums text-[var(--cv-text)]">
              {totalCount} / {totalCount} templates
            </span>
          </div>
          <p class="mt-1.5 font-mono text-[11px] text-[var(--cv-text-muted)]">
            Top row: 2-col featured Flagships. Subsequent rows: 3-col catalog specs.
          </p>
          <button
            type="button"
            data-reset-filters
            class="mt-3 inline-flex min-h-11 w-full items-center justify-center border border-[var(--cv-border)] bg-[var(--cv-surface)] px-3 py-2 font-mono text-xs font-semibold text-[var(--cv-text)] transition-colors hover:border-[var(--cv-border-strong)] hover:bg-[var(--cv-surface-hover)]"
          >
            Reset All Filters
          </button>
        </div>
      </aside>

      <!-- 75% Main Content Grid -->
      <div class="p-4 sm:p-6 lg:col-span-9 lg:p-8">
        <!-- Loading State (R-27) -->
        <div
          data-state-panel="loading"
          hidden
          role="status"
          aria-live="polite"
          class="cv-vertex-card p-8 text-center"
        >
          <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
            HYDRATING EMDASH CONTENT LAYER...
          </p>
          <p class="mt-2 text-sm text-[var(--cv-text-muted)]">
            Fetching typed template definitions and verifying SHA-256 asset checksums from
            <code>{collectionSlug}</code>.
          </p>
          <div class="mt-6 flex justify-center">
            <button
              type="button"
              data-restore-live
              class="min-h-11 border border-[var(--cv-border-strong)] bg-[var(--cv-surface-elevated)] px-4 py-2 font-mono text-xs font-semibold text-[var(--cv-text)] hover:border-[var(--cv-accent)]"
            >
              Cancel Sync &amp; Show Cached Snapshot
            </button>
          </div>
        </div>

        <!-- Error State (R-27) -->
        <div
          data-state-panel="error"
          hidden
          role="alert"
          class="cv-vertex-card border-[var(--cv-accent)] p-8"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
                EMDASH_ENDPOINT_UNREACHABLE (HTTP 503)
              </p>
              <h3 class="mt-1 text-lg font-bold text-[var(--cv-text)]">
                Remote CMS collection failed to respond within 2,500ms.
              </h3>
              <p class="mt-1 text-sm text-[var(--cv-text-muted)]">
                Verify your <code>EMDASH_READ_TOKEN</code> environment variable or switch back to the
                verified build-time snapshot.
              </p>
            </div>
            <button
              type="button"
              data-restore-live
              class="min-h-11 shrink-0 border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2.5 font-mono text-xs font-bold text-[var(--cv-accent-contrast)]"
            >
              Load Verified Snapshot
            </button>
          </div>
        </div>

        <!-- Empty State (R-27) -->
        <div
          data-state-panel="empty"
          hidden
          role="status"
          aria-live="polite"
          class="cv-vertex-card p-8"
        >
          <p class="font-mono text-xs font-bold tracking-wider text-[var(--cv-accent)]">
            0 MATCHING TEMPLATES
          </p>
          <h3 class="mt-1 text-lg font-bold text-[var(--cv-text)]">
            No templates match the active price, industry, or keyword filter.
          </h3>
          <p class="mt-1 text-sm text-[var(--cv-text-muted)]">
            Clear the active filter constraints to restore all {totalCount} EmDash templates in the
            directory.
          </p>
          <div class="mt-5">
            <button
              type="button"
              data-reset-filters
              class="min-h-11 border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2 font-mono text-xs font-bold text-[var(--cv-accent-contrast)]"
            >
              Restore All {totalCount} Templates
            </button>
          </div>
        </div>

        <!-- Mixed CSS Grid: 6-col base on lg -> top row cards span 3 (2 columns), subsequent cards span 2 (3 columns) -->
        <div
          data-templates-grid
          class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-6 lg:gap-6"
        >
          {
            templates.map((template, index) => (
              <TemplateCard
                template={template}
                isTopRowTwoCol={index < 2}
                isPriorityImage={index === 0}
              />
            ))
          }
        </div>
      </div>
    </div>

    <!-- Scoped Template Spec Modal Dialog -->
    <dialog
      data-spec-dialog
      aria-labelledby="spec-dialog-title"
      class="m-auto w-full max-w-xl border border-[var(--cv-border-strong)] bg-[var(--cv-surface)] p-0 text-[var(--cv-text)] backdrop:bg-black/75"
    >
      <div class="p-6">
        <div class="flex items-start justify-between gap-4 border-b border-dashed border-[var(--cv-border)] pb-4">
          <div>
            <p
              data-spec-collection
              class="font-mono text-xs font-semibold text-[var(--cv-accent)]"
            >
              EMDASH SCHEMA SPECIFICATION
            </p>
            <h3 id="spec-dialog-title" data-spec-title class="mt-1 text-xl font-bold">
              Template Specification
            </h3>
          </div>
          <button
            type="button"
            data-close-spec-dialog
            aria-label="Close specification dialog"
            class="min-h-11 min-w-11 border border-[var(--cv-border)] bg-[var(--cv-surface-elevated)] px-3 py-1.5 font-mono text-xs font-bold text-[var(--cv-text)] hover:border-[var(--cv-accent)]"
          >
            ESC
          </button>
        </div>

        <p data-spec-subtitle class="mt-4 text-sm text-[var(--cv-text-muted)]"></p>

        <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-b border-dashed border-[var(--cv-border)] py-4 font-mono text-xs sm:grid-cols-3">
          <div>
            <dt class="text-[var(--cv-text-muted)]">ASTRO ENGINE</dt>
            <dd class="mt-1 font-bold text-[var(--cv-text)]">v7.4 Strict</dd>
          </div>
          <div>
            <dt class="text-[var(--cv-text-muted)]">CSS PAYLOAD</dt>
            <dd data-spec-css class="mt-1 font-bold text-[var(--cv-text)]"></dd>
          </div>
          <div>
            <dt class="text-[var(--cv-text-muted)]">DOM NODES</dt>
            <dd data-spec-dom class="mt-1 font-bold text-[var(--cv-text)]"></dd>
          </div>
        </dl>

        <div class="mt-4">
          <h4 class="font-mono text-xs font-bold text-[var(--cv-text-muted)]">
            INCLUDED ROUTES &amp; SCHEMAS
          </h4>
          <ul data-spec-routes class="mt-2 flex flex-wrap gap-1.5 font-mono text-xs"></ul>
        </div>

        <div class="mt-6 flex items-center justify-end gap-3">
          <button
            type="button"
            data-close-spec-dialog
            class="min-h-11 border border-[var(--cv-border)] bg-[var(--cv-surface-elevated)] px-4 py-2 font-mono text-xs font-semibold text-[var(--cv-text)]"
          >
            Close
          </button>
          <button
            type="button"
            data-spec-add-cart
            class="min-h-11 border border-[var(--cv-accent)] bg-[var(--cv-accent)] px-4 py-2 font-mono text-xs font-bold text-[var(--cv-accent-contrast)]"
          >
            Add Template to Cart
          </button>
        </div>
      </div>
    </dialog>

    <script
      type="application/json"
      data-templates-json
      set:html={JSON.stringify(templates)}
    />
  </cv-storefront>
</section>

<script>
  import type { EmDashTemplateNode } from '../data/emdash-cms';

  class CvStorefront extends HTMLElement {
    private activePrice = 'all';
    private activeIndustry = 'all';
    private searchQuery = '';
    private cmsState: 'ready' | 'loading' | 'empty' | 'error' = 'ready';
    private templatesData: EmDashTemplateNode[] = [];

    connectedCallback() {
      const jsonScript = this.querySelector<HTMLScriptElement>('[data-templates-json]');
      if (jsonScript?.textContent) {
        try {
          this.templatesData = JSON.parse(jsonScript.textContent);
        } catch {
          this.templatesData = [];
        }
      }

      const priceButtons = this.querySelectorAll<HTMLButtonElement>('[data-filter-price]');
      const industryButtons = this.querySelectorAll<HTMLButtonElement>('[data-filter-industry]');
      const searchInput = this.querySelector<HTMLInputElement>('[data-search-input]');
      const resetButtons = this.querySelectorAll<HTMLButtonElement>('[data-reset-filters]');
      const cmsStateButtons = this.querySelectorAll<HTMLButtonElement>('[data-cms-state-btn]');
      const restoreLiveButtons = this.querySelectorAll<HTMLButtonElement>('[data-restore-live]');

      priceButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          this.activePrice = btn.dataset.filterPrice || 'all';
          this.cmsState = 'ready';
          this.updateFilterButtonStyles(priceButtons, 'filterPrice', this.activePrice);
          this.applyFilters();
        });
      });

      industryButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          this.activeIndustry = btn.dataset.filterIndustry || 'all';
          this.cmsState = 'ready';
          this.updateFilterButtonStyles(industryButtons, 'filterIndustry', this.activeIndustry);
          this.applyFilters();
        });
      });

      searchInput?.addEventListener('input', () => {
        this.searchQuery = searchInput.value.trim().toLowerCase();
        this.cmsState = 'ready';
        this.applyFilters();
      });

      resetButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          this.activePrice = 'all';
          this.activeIndustry = 'all';
          this.searchQuery = '';
          this.cmsState = 'ready';
          if (searchInput) searchInput.value = '';
          this.updateFilterButtonStyles(priceButtons, 'filterPrice', 'all');
          this.updateFilterButtonStyles(industryButtons, 'filterIndustry', 'all');
          this.syncCmsStateButtons();
          this.applyFilters();
        });
      });

      cmsStateButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const nextState = (btn.dataset.cmsStateBtn || 'ready') as
            | 'ready'
            | 'loading'
            | 'empty'
            | 'error';
          this.cmsState = nextState;
          this.syncCmsStateButtons();
          this.applyFilters();
        });
      });

      restoreLiveButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          this.cmsState = 'ready';
          this.syncCmsStateButtons();
          this.applyFilters();
        });
      });

      this.setupSpecModal();
      this.setupAddToCartButtons();
    }

    private syncCmsStateButtons() {
      const cmsStateButtons = this.querySelectorAll<HTMLButtonElement>('[data-cms-state-btn]');
      cmsStateButtons.forEach((btn) => {
        const isCurrent = btn.dataset.cmsStateBtn === this.cmsState;
        btn.setAttribute('aria-pressed', String(isCurrent));
        btn.classList.toggle('border-[var(--cv-accent)]', isCurrent);
        btn.classList.toggle('bg-[var(--cv-surface-elevated)]', isCurrent);
        btn.classList.toggle('font-semibold', isCurrent);
        btn.classList.toggle('text-[var(--cv-text)]', isCurrent);
        btn.classList.toggle('border-[var(--cv-border)]', !isCurrent);
        btn.classList.toggle('text-[var(--cv-text-muted)]', !isCurrent);
      });
    }

    private updateFilterButtonStyles(
      buttons: NodeListOf<HTMLButtonElement>,
      datasetKey: 'filterPrice' | 'filterIndustry',
      activeValue: string
    ) {
      buttons.forEach((btn) => {
        const isSelected = btn.dataset[datasetKey] === activeValue;
        btn.setAttribute('aria-pressed', String(isSelected));
        btn.classList.toggle('border-[var(--cv-accent)]', isSelected);
        btn.classList.toggle('bg-[var(--cv-surface-elevated)]', isSelected);
        btn.classList.toggle('font-bold', isSelected);
        btn.classList.toggle('text-[var(--cv-text)]', isSelected);
        btn.classList.toggle('border-transparent', !isSelected);
        btn.classList.toggle('font-normal', !isSelected);
        btn.classList.toggle('text-[var(--cv-text-muted)]', !isSelected);
      });
    }

    private applyFilters() {
      const cards = this.querySelectorAll<HTMLElement>('[data-template-card]');
      const grid = this.querySelector<HTMLElement>('[data-templates-grid]');
      const loadingPanel = this.querySelector<HTMLElement>('[data-state-panel="loading"]');
      const errorPanel = this.querySelector<HTMLElement>('[data-state-panel="error"]');
      const emptyPanel = this.querySelector<HTMLElement>('[data-state-panel="empty"]');
      const countSummary = this.querySelector<HTMLElement>('[data-visible-count-summary]');
      const total = Number(this.dataset.totalTemplates || cards.length);

      if (this.cmsState === 'loading') {
        grid?.setAttribute('hidden', '');
        loadingPanel?.removeAttribute('hidden');
        errorPanel?.setAttribute('hidden', '');
        emptyPanel?.setAttribute('hidden', '');
        if (countSummary) countSummary.textContent = `Syncing / ${total} templates`;
        return;
      }

      if (this.cmsState === 'error') {
        grid?.setAttribute('hidden', '');
        loadingPanel?.setAttribute('hidden', '');
        errorPanel?.removeAttribute('hidden');
        emptyPanel?.setAttribute('hidden', '');
        if (countSummary) countSummary.textContent = `Offline / ${total} templates`;
        return;
      }

      if (this.cmsState === 'empty') {
        grid?.setAttribute('hidden', '');
        loadingPanel?.setAttribute('hidden', '');
        errorPanel?.setAttribute('hidden', '');
        emptyPanel?.removeAttribute('hidden');
        if (countSummary) countSummary.textContent = `0 / ${total} templates`;
        return;
      }

      loadingPanel?.setAttribute('hidden', '');
      errorPanel?.setAttribute('hidden', '');

      let visibleIndex = 0;
      cards.forEach((card) => {
        const priceType = card.dataset.priceType || '';
        const industry = card.dataset.industry || '';
        const title = (card.dataset.title || '').toLowerCase();
        const textContent = (card.textContent || '').toLowerCase();

        const matchesPrice = this.activePrice === 'all' || priceType === this.activePrice;
        const matchesIndustry = this.activeIndustry === 'all' || industry === this.activeIndustry;
        const matchesQuery =
          !this.searchQuery ||
          title.includes(this.searchQuery) ||
          textContent.includes(this.searchQuery);

        const isVisible = matchesPrice && matchesIndustry && matchesQuery;
        if (isVisible) {
          card.removeAttribute('hidden');
          // Maintain mixed grid hierarchy: top 2 visible cards span 2 columns (lg:col-span-3), rest span 3 columns (lg:col-span-2)
          const isTopTwo = visibleIndex < 2;
          card.classList.toggle('lg:col-span-3', isTopTwo);
          card.classList.toggle('sm:col-span-2', isTopTwo);
          card.classList.toggle('lg:col-span-2', !isTopTwo);
          card.classList.toggle('sm:col-span-1', !isTopTwo);
          visibleIndex++;
        } else {
          card.setAttribute('hidden', '');
        }
      });

      if (countSummary) {
        countSummary.textContent = `${visibleIndex} / ${total} templates`;
      }

      if (visibleIndex === 0) {
        grid?.setAttribute('hidden', '');
        emptyPanel?.removeAttribute('hidden');
      } else {
        grid?.removeAttribute('hidden');
        emptyPanel?.setAttribute('hidden', '');
      }
    }

    private setupSpecModal() {
      const dialog = this.querySelector<HTMLDialogElement>('[data-spec-dialog]');
      if (!dialog) return;

      const titleEl = dialog.querySelector<HTMLElement>('[data-spec-title]');
      const subtitleEl = dialog.querySelector<HTMLElement>('[data-spec-subtitle]');
      const collectionEl = dialog.querySelector<HTMLElement>('[data-spec-collection]');
      const cssEl = dialog.querySelector<HTMLElement>('[data-spec-css]');
      const domEl = dialog.querySelector<HTMLElement>('[data-spec-dom]');
      const routesList = dialog.querySelector<HTMLElement>('[data-spec-routes]');
      const addCartBtn = dialog.querySelector<HTMLButtonElement>('[data-spec-add-cart]');
      const closeButtons = dialog.querySelectorAll<HTMLButtonElement>('[data-close-spec-dialog]');

      let currentTemplate: EmDashTemplateNode | null = null;

      this.querySelectorAll<HTMLButtonElement>('[data-inspect-template]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.inspectTemplate;
          const found = this.templatesData.find((t) => t.id === id);
          if (!found) return;
          currentTemplate = found;

          if (titleEl) titleEl.textContent = found.title;
          if (subtitleEl) subtitleEl.textContent = found.subtitle;
          if (collectionEl)
            collectionEl.textContent = `COLLECTION: ${found.emdashCollection} // ${found.styleTag}`;
          if (cssEl) cssEl.textContent = found.cssPayloadKb;
          if (domEl) domEl.textContent = `${found.domNodesCount} nodes`;
          if (routesList) {
            routesList.innerHTML = found.routesIncluded
              .map(
                (route) =>
                  `<li class="border border-[var(--cv-border)] bg-[var(--cv-surface-elevated)] px-2.5 py-1 text-[var(--cv-text)]">${route}</li>`
              )
              .join('');
          }
          if (addCartBtn) {
            addCartBtn.textContent =
              found.price === 0
                ? `Add Free Template ($0)`
                : `Add to Cart (${found.priceDisplay})`;
          }

          dialog.showModal();
        });
      });

      closeButtons.forEach((btn) => {
        btn.addEventListener('click', () => dialog.close());
      });

      addCartBtn?.addEventListener('click', () => {
        if (!currentTemplate) return;
        window.dispatchEvent(
          new CustomEvent('cv:cart-add', {
            detail: {
              id: currentTemplate.id,
              title: currentTemplate.title,
              price: currentTemplate.price,
            },
          })
        );
        dialog.close();
      });
    }

    private setupAddToCartButtons() {
      this.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.addToCart || '';
          const title = btn.dataset.itemTitle || 'Template';
          const price = Number(btn.dataset.itemPrice || 0);
          window.dispatchEvent(
            new CustomEvent('cv:cart-add', {
              detail: { id, title, price },
            })
          );
        });
      });
    }
  }

  if (!customElements.get('cv-storefront')) {
    customElements.define('cv-storefront', CvStorefront);
  }
</script>
