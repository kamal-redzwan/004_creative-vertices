---
interface Props {
  totalTemplatesCount?: number;
  freeTemplatesCount?: number;
  bundlePrice?: number;
  retailValue?: number;
  syncedAtIso?: string;
}
---

<section
  aria-labelledby="hero-heading"
  class="border-b border-dashed border-[var(--cv-rail)] px-4 py-14 sm:px-6 md:py-20 lg:px-8 lg:py-24"
>
  <div class="max-w-4xl text-left">
    <h1
      id="hero-heading"
      class="text-5xl md:text-7xl font-semibold tracking-tight text-[var(--cv-text)] leading-[1.06]"
    >
      Architectural Astro Templates. Built for the Modern Web.
    </h1>

    <p class="mt-6 max-w-3xl text-lg md:text-xl leading-relaxed text-gray-400">
      Skip the boilerplate. Ship lightning-fast, visually stunning websites with
      distraction-free Astro v7 codebases. Fully typed, GDPR-compliant, and
      wired for EmDash CMS.
    </p>

    <div
      class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-gray-500 uppercase tracking-widest"
      aria-label="Technical specifications"
    >
      <span>ASTRO v7.4</span>
      <span aria-hidden="true">·</span>
      <span>TAILWIND v4.3</span>
      <span aria-hidden="true">·</span>
      <span>EMDASH CMS v3.8</span>
      <span aria-hidden="true">·</span>
      <span>0 EXTERNAL REQUESTS</span>
    </div>
  </div>
</section>
